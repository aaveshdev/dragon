object DragonColors {
    val ObsidianBg = Color(0xFF14171F)
    val ObsidianSurface = Color(0xFF1D2230)
    val ObsidianSurfaceRaised = Color(0xFF262C3D)
    val Ember = Color(0xFFE8935B)
    val EmberDeep = Color(0xFFC96B3E)
    val Verdigris = Color(0xFF4FB0A5)
    val TextPrimary = Color(0xFFF2EDE4)
    val TextMuted = Color(0xFF8A8F9E)
    val Divider = Color(0xFF2C3244)
}


data class DragonFonts(
    val display: FontFamily = FontFamily.SansSerif,
    val body: FontFamily = FontFamily.SansSerif,
)

fun dragonTypography(fonts: DragonFonts): Typography = Typography(
    headlineMedium = TextStyle(
        fontFamily = fonts.display, fontWeight = FontWeight.SemiBold, fontSize = 24.sp, letterSpacing = 0.2.sp
    ),
    titleMedium = TextStyle(
        fontFamily = fonts.display, fontWeight = FontWeight.Medium, fontSize = 17.sp, letterSpacing = 0.1.sp
    ),
    bodyLarge = TextStyle(
        fontFamily = fonts.body, fontWeight = FontWeight.Normal, fontSize = 16.sp, lineHeight = 22.sp
    ),
    bodyMedium = TextStyle(
        fontFamily = fonts.body, fontWeight = FontWeight.Normal, fontSize = 14.sp, lineHeight = 20.sp
    ),
    labelLarge = TextStyle(
        fontFamily = fonts.display, fontWeight = FontWeight.Medium, fontSize = 14.sp, letterSpacing = 0.4.sp
    ),
)

class CutCornerDragonShape(private val cut: Dp) : Shape {
    override fun createOutline(
        size: Size,
        layoutDirection: LayoutDirection,
        density: androidx.compose.ui.unit.Density
    ): androidx.compose.ui.graphics.Outline {
        val c = with(density) { cut.toPx() }.coerceAtMost(size.minDimension / 2f)
        val path = Path().apply {
            moveTo(0f, 0f)
            lineTo(size.width - c, 0f)
            lineTo(size.width, c)
            lineTo(size.width, size.height)
            lineTo(0f, size.height)
            close()
        }
        return androidx.compose.ui.graphics.Outline.Generic(path)
    }
}

val DragonCardShape = CutCornerDragonShape(14.dp)
val DragonButtonShape = CutCornerDragonShape(10.dp)
val DragonFieldShape = CutCornerDragonShape(8.dp)

data class DragonPalette(
    val primary: Color = DragonColors.Ember,
    val primaryDeep: Color = DragonColors.EmberDeep,
    val secondary: Color = DragonColors.Verdigris,
    val background: Color = DragonColors.ObsidianBg,
    val surface: Color = DragonColors.ObsidianSurface,
    val surfaceRaised: Color = DragonColors.ObsidianSurfaceRaised,
    val textPrimary: Color = DragonColors.TextPrimary,
    val textMuted: Color = DragonColors.TextMuted,
    val divider: Color = DragonColors.Divider,
    val dark: Boolean = true,
)

private val LightDragonPalette = DragonPalette(
    background = Color(0xFFFAF7F2),
    surface = Color(0xFFFFFFFF),
    surfaceRaised = Color(0xFFF1EDE6),
    textPrimary = Color(0xFF1B1E27),
    textMuted = Color(0xFF6B7080),
    divider = Color(0xFFE3DFD8),
    dark = false,
)

data class DragonTokens(
    val palette: DragonPalette = DragonPalette(),
    val cardShape: Shape = DragonCardShape,
    val buttonShape: Shape = DragonButtonShape,
    val fieldShape: Shape = DragonFieldShape,
) {
    val primary get() = palette.primary
    val primaryDeep get() = palette.primaryDeep
    val secondary get() = palette.secondary
    val background get() = palette.background
    val surface get() = palette.surface
    val surfaceRaised get() = palette.surfaceRaised
    val textPrimary get() = palette.textPrimary
    val textMuted get() = palette.textMuted
    val divider get() = palette.divider
    val emberGlow: Brush get() = Brush.linearGradient(listOf(palette.primary, palette.primaryDeep))
}

val LocalDragonTokens = compositionLocalOf { DragonTokens() }

private fun parseHexOrNull(hex: String): Color? {
    if (hex.isEmpty()) return null
    return try {
        val cleaned = hex.removePrefix("#")
        val value = cleaned.toLong(16)
        when (cleaned.length) {
            6 -> Color(0xFF000000L or value)
            8 -> Color(value)
            else -> null
        }
    } catch (e: NumberFormatException) {
        null
    }
}

fun paletteFromThemeJson(themeJson: String): DragonPalette {
    if (themeJson.isEmpty()) return DragonPalette()
    return try {
        val obj = JSONObject(themeJson)
        val dark = obj.optBoolean("dark", true)
        val base = if (dark) DragonPalette() else LightDragonPalette
        base.copy(
            primary = parseHexOrNull(obj.optString("primary")) ?: base.primary,
            secondary = parseHexOrNull(obj.optString("secondary")) ?: base.secondary,
            background = parseHexOrNull(obj.optString("background")) ?: base.background,
            surface = parseHexOrNull(obj.optString("surface")) ?: base.surface,
            dark = dark,
        )
    } catch (e: Exception) {
        DragonPalette()
    }
}

@Composable
fun DragonTheme(themeJson: String = "", fonts: DragonFonts = DragonFonts(), content: @Composable () -> Unit) {
    val palette = paletteFromThemeJson(themeJson)
    val tokens = DragonTokens(palette = palette)
    val colorScheme = if (palette.dark) {
        darkColorScheme(
            background = palette.background,
            surface = palette.surface,
            surfaceVariant = palette.surfaceRaised,
            primary = palette.primary,
            secondary = palette.secondary,
            onBackground = palette.textPrimary,
            onSurface = palette.textPrimary,
            onPrimary = DragonColors.ObsidianBg,
            onSecondary = DragonColors.ObsidianBg,
            outline = palette.divider,
        )
    } else {
        lightColorScheme(
            background = palette.background,
            surface = palette.surface,
            surfaceVariant = palette.surfaceRaised,
            primary = palette.primary,
            secondary = palette.secondary,
            onBackground = palette.textPrimary,
            onSurface = palette.textPrimary,
            onPrimary = Color.White,
            onSecondary = Color.White,
            outline = palette.divider,
        )
    }
    CompositionLocalProvider(LocalDragonTokens provides tokens) {
        MaterialTheme(
            colorScheme = colorScheme,
            typography = dragonTypography(fonts),
            content = content
        )
    }
}
