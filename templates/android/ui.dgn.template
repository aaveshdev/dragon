
func widget_array(children: strlist) {
    out = "";
    first = True;
    for child in children {
        if (first) {
            out = child;
            first = False;
        } else {
            out = out + "," + child;
        }
    }
    return "[" + out + "]";
}


func Text(content: str) {
    return "{\"type\":\"text\",\"text\":\"" + json_escape(content) + "\"}";
}


