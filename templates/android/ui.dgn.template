theme_surface = "";
theme_dark = True;

func theme() {
    dark_str = "false";
    if (theme_dark) {
        dark_str = "true";
    }
    return "{\"primary\":\"" + json_escape(theme_primary) + "\",\"secondary\":\"" + json_escape(theme_secondary)
        + "\",\"background\":\"" + json_escape(theme_background) + "\",\"surface\":\"" + json_escape(theme_surface)
        + "\",\"dark\":" + dark_str + "}";
}

func set_theme(primary: str, secondary: str, background: str, surface: str, dark: bool) {
    theme_primary = primary;
    theme_secondary = secondary;
    theme_background = background;
    theme_surface = surface;
    theme_dark = dark;
    return 0;
}

func toggle_dark_mode() {
    if (theme_dark) {
        theme_dark = False;
    } else {
        theme_dark = True;
    }
    return 0;
}


__http_url = "";
__http_event = "";
__http_method = "GET";
__http_body = "";
__http_seq = 0;

func http_get(url: str, event: str) {
    __http_url = url;
    __http_event = event;
    __http_method = "GET";
    __http_body = "";
    __http_seq = __http_seq + 1;
    return 0;
}

func http_post(url: str, event: str, body: str) {
    __http_url = url;
    __http_event = event;
    __http_method = "POST";
    __http_body = body;
    __http_seq = __http_seq + 1;
    return 0;
}

func http_request_seq() {
    return __http_seq;
}
func http_request_url() {
    return __http_url;
}
func http_request_event() {
    return __http_event;
}
func http_request_method() {
    return __http_method;
}
func http_request_body() {
    return __http_body;
}

func str_after_prefix(s: str, prefix: str) {
    return substr(s, len(prefix), len(s) - len(prefix));
}

func http_status_of(evt: str, event_prefix: str) {
    rest = str_after_prefix(evt, event_prefix);
    return parse_int(substr(rest, 0, 3));
}

func http_body_of(evt: str, event_prefix: str) {
    rest = str_after_prefix(evt, event_prefix);
    return substr(rest, 4, len(rest) - 4);
}

func http_ok(evt: str, event_prefix: str) {
    status = http_status_of(evt, event_prefix);
    if (status < 200) {
        return False;
    }
    if (status >= 300) {
        return False;
    }
    return True;
}


