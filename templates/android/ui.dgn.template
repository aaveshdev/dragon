storage_dir = "";
asset_dir = "";

func set_storage_dir(path: str) {
    storage_dir = path;
    return 0;
}
func set_asset_dir(path: str) {
    asset_dir = path;
    return 0;
}

func doc_path(filename: str) {
    return storage_dir + "/" + filename;
}
func asset_path(filename: str) {
    return asset_dir + "/" + filename;
}

func read_doc(filename: str) {
    return file_read(doc_path(filename));
}
func write_doc(filename: str, content: str) {
    return file_write(doc_path(filename), content);
}
func append_doc(filename: str, content: str) {
    return file_append(doc_path(filename), content);
}
func doc_exists(filename: str) {
    return file_exists(doc_path(filename));
}
func delete_doc(filename: str) {
    return file_delete(doc_path(filename));
}

func read_asset(filename: str) {
    return file_read(asset_path(filename));
}
func asset_exists(filename: str) {
    return file_exists(asset_path(filename));
}


