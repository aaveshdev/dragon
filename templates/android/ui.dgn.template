func Snackbar(visible: bool, message: str, action_label: str, action_event: str) {
    return "{\"type\":\"snackbar\",\"visible\":" + bool_str(visible) + ",\"message\":\"" + json_escape(message)
        + "\",\"actionLabel\":\"" + json_escape(action_label) + "\",\"actionEvent\":\"" + json_escape(action_event) + "\"}";
}

func BottomNavigationBar(labels: strlist, selected_index: int, event: str) {
    return "{\"type\":\"bottom_nav\",\"labels\":" + widget_array_of_strings(labels)
        + ",\"selected\":" + selected_index + ",\"event\":\"" + json_escape(event) + "\"}";
}


__nav_depth = 1;
__nav_0 = "/";
__nav_1 = "";
__nav_2 = "";
__nav_3 = "";
__nav_4 = "";

func nav_push(route: str) {
    if (__nav_depth == 1) { __nav_1 = route; __nav_depth = 2; }
    else if (__nav_depth == 2) { __nav_2 = route; __nav_depth = 3; }
    else if (__nav_depth == 3) { __nav_3 = route; __nav_depth = 4; }
    else if (__nav_depth == 4) { __nav_4 = route; __nav_depth = 5; }
    return 0;
}

func nav_pop() {
    if (__nav_depth > 1) {
        __nav_depth = __nav_depth - 1;
    }
    return 0;
}

func nav_replace(route: str) {
    if (__nav_depth == 1) { __nav_0 = route; }
    else if (__nav_depth == 2) { __nav_1 = route; }
    else if (__nav_depth == 3) { __nav_2 = route; }
    else if (__nav_depth == 4) { __nav_3 = route; }
    else if (__nav_depth == 5) { __nav_4 = route; }
    return 0;
}

func nav_reset(route: str) {
    __nav_depth = 1;
    __nav_0 = route;
    return 0;
}

func nav_route() {
    if (__nav_depth == 1) { return __nav_0; }
    else if (__nav_depth == 2) { return __nav_1; }
    else if (__nav_depth == 3) { return __nav_2; }
    else if (__nav_depth == 4) { return __nav_3; }
    return __nav_4;
}

func nav_can_pop() {
    return __nav_depth > 1;
}

func nav_depth() {
    return __nav_depth;
}

func str_starts_with(s: str, prefix: str) {
    return index_of(s, prefix) == 0;
}

func str_after(s: str, prefix_len: int) {
    return substr(s, prefix_len, len(s) - prefix_len);
}

func Page(content: str) {
    key = nav_route() + ":" + nav_depth();
    return "{\"type\":\"page\",\"key\":\"" + json_escape(key) + "\",\"content\":" + content + "}";
}
