// A small rounded pill, typically for tags/filters/categories.
func Chip(label: str, event: str) {
    return "{\"type\":\"chip\",\"label\":\"" + json_escape(label) + "\",\"event\":\"" + json_escape(event) + "\"}";
}

// A small numbered overlay pinned to the top-right corner of `child` --
// e.g. an unread-count badge on a notification Icon(). count <= 0 hides
// the badge entirely (shows just `child`, unbadged).
func Badge(child: str, count: int) {
    return "{\"type\":\"badge\",\"count\":" + count + ",\"child\":" + child + "}";
}

// ── Selection ────────────────────────────────────────────────────────────

// A single-select group, rendered as a column of radio options. `options`
// are the labels shown; `selected` is which one is currently checked
// (must match one of `options` exactly, or none will show checked); fires
// "<event>:<label>" when a different option is tapped -- same convention
// as TextField's change event.
func RadioGroup(options: strlist, selected: str, event: str) {
    return "{\"type\":\"radio_group\",\"options\":" + widget_array_of_strings(options)
        + ",\"selected\":\"" + json_escape(selected) + "\",\"event\":\"" + json_escape(event) + "\"}";
}

// A tap-to-open list of options. `selected` is the currently shown value
// (must match one of `options`, or the field just shows blank); fires
// "<event>:<label>" when a different option is chosen.
func DropdownButton(options: strlist, selected: str, event: str) {
    return "{\"type\":\"dropdown\",\"options\":" + widget_array_of_strings(options)
        + ",\"selected\":\"" + json_escape(selected) + "\",\"event\":\"" + json_escape(event) + "\"}";
}

// Shared plumbing for RadioGroup()/DropdownButton() -- a JSON array of
// plain (escaped) strings, as opposed to widget_array()'s array of
// already-built widget JSON objects.
func widget_array_of_strings(items: strlist) {
    out = "";
    first = True;
    for item in items {
        piece = "\"" + json_escape(item) + "\"";
        if (first) {
            out = piece;
            first = False;
        } else {
            out = out + "," + piece;
        }
    }
    return "[" + out + "]";
}

// ── Feedback ─────────────────────────────────────────────────────────────

// A spinning, indeterminate loading indicator.
func CircularProgress() {
    return "{\"type\":\"circular_progress\"}";
}

// value: 0.0-1.0. A determinate horizontal progress bar (e.g. a download
// or upload's actual percentage) -- use CircularProgress() instead for
// "working, but no known duration/percentage" states.
func LinearProgress(value: float) {
    return "{\"type\":\"linear_progress\",\"value\":" + value + "}";
}

// A modal popup, found anywhere in your tree (like FloatingActionButton,
// it doesn't need to be a direct child of anything specific) and shown
// when `visible` is True, blocking interaction with the rest of the
// screen until dismissed. confirm_event/dismiss_event fire when their
// respective button is tapped -- your on_event should set `visible` back
// to False in response to whichever one fires (the dialog doesn't close
// itself; Dragon's state is always the source of truth for what's on
// screen, same as everything else in this schema).
func AlertDialog(visible: bool, title: str, message: str, confirm_label: str, confirm_event: str, dismiss_label: str, dismiss_event: str) {
    visible_str = "false";
    if (visible) {
        visible_str = "true";
    }
    return "{\"type\":\"alert_dialog\",\"visible\":" + visible_str + ",\"title\":\"" + json_escape(title)
        + "\",\"message\":\"" + json_escape(message) + "\",\"confirmLabel\":\"" + json_escape(confirm_label)
        + "\",\"confirmEvent\":\"" + json_escape(confirm_event) + "\",\"dismissLabel\":\"" + json_escape(dismiss_label)
        + "\",\"dismissEvent\":\"" + json_escape(dismiss_event) + "\"}";
}

// A transient bottom message, found anywhere in your tree. Same
// visible-is-the-source-of-truth convention as AlertDialog -- your
// on_event should set `visible` back to False when action_event fires (or
// on a timer via whatever periodic-tick mechanism your app already uses,
// if you want it to auto-dismiss).
func Snackbar(visible: bool, message: str, action_label: str, action_event: str) {
    visible_str = "false";
    if (visible) {
        visible_str = "true";
    }
    return "{\"type\":\"snackbar\",\"visible\":" + visible_str + ",\"message\":\"" + json_escape(message)
        + "\",\"actionLabel\":\"" + json_escape(action_label) + "\",\"actionEvent\":\"" + json_escape(action_event) + "\"}";
}


// A bottom tab bar. `labels` are the tab names; `selected_index` is which
// one is currently active; fires "<event>:<index>" when a different tab
// is tapped.
func BottomNavigationBar(labels: strlist, selected_index: int, event: str) {
    return "{\"type\":\"bottom_nav\",\"labels\":" + widget_array_of_strings(labels)
        + ",\"selected\":" + selected_index + ",\"event\":\"" + json_escape(event) + "\"}";
}
