func widget_array(children: strlist) {
    out = "";
    first = True;
    for child in children {
        if (first) {
            out = child;
            first = False;
        } else {
            out = out + "," + child;
        }
    }
    return "[" + out + "]";
}

func widget_array_of_strings(items: strlist) {
    out = "";
    first = True;
    for item in items {
        piece = "\"" + json_escape(item) + "\"";
        if (first) {
            out = piece;
            first = False;
        } else {
            out = out + "," + piece;
        }
    }
    return "[" + out + "]";
}

func bool_str(value: bool) {
