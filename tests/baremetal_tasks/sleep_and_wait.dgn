import hw
import task

func worker(name) {
    i = 0
    while (i < 3) {
        showln(name + " step " + str(i))
        task.sleep(50)
        i = i + 1
    }
}

func main() {
    showln("uart line status = " + str(hw.peek8(268435461)))
    showln("clock ms >= 0: " + str(hw.millis() >= 0))
    a = task.spawn(worker, "A")
    b = task.spawn(worker, "B")
    showln("spawned " + str(a) + " " + str(b) + " count=" + str(task.count()))
    task.wait(a)
    task.wait(b)
    showln("all done, count=" + str(task.count()) + " ticks>0: " + str(hw.ticks() > 0))
}
main()
