import hw
import task

flag = [0]
func spinner() {

    n = 0
    while (flag[0] == 0) { n = n + 1 }
    showln("spinner released after spinning")
}
func setter() {
    task.sleep(100)
    flag[0] = 1
}

func churn(tag, rounds) {
    total = 0
    i = 0
    while (i < rounds) {
        xs = []
        j = 0
        while (j < 15) { xs.push(tag + str(i * j)); j = j + 1 }
        m = {k: xs, n: i}
        total = total + len(m.k) + m.n
        i = i + 1
    }
    return total
}
results = {}
func gcworker(tag) {
    results[tag] = churn(tag, 12000)
}

func thrower() {
    try {
        raise "boom in task"
    } catch (err) {
        showln("task caught: " + str(err))
    }
}

counter = [0]
func incr() {
    i = 0
    while (i < 2000) {
        task.atomic(func() { counter[0] = counter[0] + 1 })
        i = i + 1
    }
}

func main() {
    s = task.spawn(spinner)
    t = task.spawn(setter)
    task.wait(s)
    task.wait(t)
    showln("preemption ok")

    ids = [task.spawn(gcworker, "a"), task.spawn(gcworker, "b"), task.spawn(gcworker, "c")]
    own = churn("m", 12000)
    for id in ids { task.wait(id) }
    showln("gc under tasks: " + str(results.a) + " " + str(results.b) + " " + str(results.c) + " main=" + str(own))

    task.wait(task.spawn(thrower))
    try { raise "main boom" } catch (e) { showln("main caught: " + str(e)) }

    w = [task.spawn(incr), task.spawn(incr), task.spawn(incr)]
    for id in w { task.wait(id) }
    showln("atomic counter = " + str(counter[0]))
    showln("tasks left: " + str(task.count()))
}
main()
