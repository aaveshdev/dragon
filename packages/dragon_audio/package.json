{
  "name": "dragon_audio",
  "version": "1.0.0",
  "description": "Music library and background audio playback (Media3, foreground service, media session)",
  "main": "lib/dragon_audio.dgn",
  "android": {
    "plugin": "org.dragonlang.runtime.DragonAudioPlugin",
    "permissions": [
      "android.permission.READ_MEDIA_AUDIO",
      {
        "name": "android.permission.READ_EXTERNAL_STORAGE",
        "maxSdkVersion": 32
      },
      "android.permission.FOREGROUND_SERVICE",
      "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
      "android.permission.WAKE_LOCK"
    ],
    "gradle": [
      "implementation(\"androidx.media3:media3-exoplayer:1.3.1\")",
      "implementation(\"androidx.media3:media3-session:1.3.1\")"
    ],
    "manifest": "native/android/manifest.xml"
  },
  "ios": {
    "plugin": "DragonAudioPlugin"
  },
  "windows": {
    "plugin": "DragonAudioPlugin",
    "nuget": [
      "TagLibSharp:2.3.0"
    ]
  }
}