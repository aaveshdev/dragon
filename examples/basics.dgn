func main() {
    name = "Dragon"
    version = 1.0

    showln(`Welcome to ${name} v${version}!`)

    age = 5
    is_awesome = True
    showln("age:", age, "| awesome:", is_awesome)

    const GREETING = "Hello"
    showln(GREETING + ", World!")

    a = 10
    b = 3
    showln(`${a} + ${b} = ${a + b}`)
    showln(`${a} - ${b} = ${a - b}`)
    showln(`${a} * ${b} = ${a * b}`)
    showln(`${a} / ${b} = ${a / b}`)
    showln(`${a} % ${b} = ${a % b}`)

    pi = 3.14159
    showln(format("Pi rounded to 2 places: {:.2f}", pi))
    showln(format("Padded number: [{:>6}]", 42))

    showln("typeof age:", typeof(age))
    showln("str(age):", str(age))
    showln("int(\"42\"):", int("42"))
}

main()
