import math

func classify(n) {
    if n < 0 {
        return "negative"
    } elif n == 0 {
        return "zero"
    } elif n % 2 == 0 {
        return "positive even"
    } else {
        return "positive odd"
    }
}

func main() {
    for n in [-3, 0, 4, 7] {
        showln(`${n} is ${classify(n)}`)
    }

    countdown = 5
    while countdown > 0 {
        show(`${countdown} `)
        countdown = countdown - 1
    }
    showln("liftoff!")

    tries = 0
    do {
        tries = tries + 1
        showln(`attempt #${tries}`)
    } while tries < 3

    fruits = ["apple", "banana", "cherry"]
    for i, fruit in fruits {
        showln(`${i}: ${fruit}`)
    }

    for n in math.range(1, 20) {
        if n % 2 != 0 {
            continue
        }
        if n > 10 {
            break
        }
        show(`${n} `)
    }
    showln("")

    for day in ["Mon", "Sat", "Sun", "Wed"] {
        switch day {
            case "Sat":
                showln(`${day}: weekend (Saturday)`)
            case "Sun":
                showln(`${day}: weekend (Sunday)`)
            default:
                showln(`${day}: weekday`)
        }
    }

    score = 82
    grade = score >= 90 ? "A" : score >= 80 ? "B" : "C"
    showln(`score ${score} -> grade ${grade}`)
}

main()
