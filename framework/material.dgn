class Dropdown extends RenderWidget {
    func init(items, onChange, value = null, hint = null, isExpanded = False, key = null) {
        super.init(key: key)
        this.items = items == null ? [] : items
        this.onChange = onChange
        this.value = value
        this.hint = hint
        this.isExpanded = isExpanded
    }
    func toNode(context) {
        nodes = []
        selected = -1
        idx = 0
        for it in this.items {
            nodes.push({label: context.build(it.child, idx), enabled: it.enabled})
            if (selected < 0 and this.value != null and u_eq(it.value, this.value)) { selected = idx }
            idx = idx + 1
        }
        its = this.items
        cb = this.onChange
        handler = func(i) { if (cb != null and i >= 0 and i < len(its)) { cb(its[i].value) } }
        return {type: "dropdown", items: nodes, selected: selected, hint: context.build(this.hint, "hint"),
                expanded: this.isExpanded, enabled: cb != null, onChanged: context.on(handler, "int")}
    }
}

class MenuItem {
    func init(child, value = null, enabled = True, onTap = null) {
        this.child = child
        this.value = value
        this.enabled = enabled
        this.onTap = onTap
        this.divider = False
    }
}
class MenuRule {
    func init() {
        this.child = null
        this.value = null
        this.enabled = False
        this.divider = True
    }
}

class Menu extends RenderWidget {
    func init(itemBuilder, onSelected = null, icon = null, child = null, enabled = True, key = null) {
        super.init(key: key)
        this.itemBuilder = itemBuilder
        this.onSelected = onSelected
        this.icon = icon
        this.child = child
        this.enabled = enabled
    }
    func toNode(context) {
        its = this.itemBuilder(context)
        nodes = []
        idx = 0
        for it in its {
            if (it.divider) {
                nodes.push({divider: True})
            } else {
                nodes.push({label: context.build(it.child, idx), enabled: it.enabled})
            }
            idx = idx + 1
        }
        cb = this.onSelected
        handler = func(i) {
            if (i >= 0 and i < len(its)) {
                if (its[i].onTap != null) { its[i].onTap() }
                if (cb != null) { cb(its[i].value) }
            }
        }
        anchor = this.child ?? this.icon ?? Icon(Icons.more_vert)
        return {type: "popupMenu", items: nodes, enabled: this.enabled, onSelected: context.on(handler, "int"),
                child: context.build(anchor, "anchor")}
    }
}

