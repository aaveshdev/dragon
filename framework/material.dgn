        this.autofocus = autofocus
        this.style = style
        this.textAlign = textAlign
        this.initialValue = initialValue
        this.textCapitalization = textCapitalization
        this.onTap = onTap
        this.validator = validator
        this.onSaved = onSaved
        this.autovalidate = autovalidate
    }
