class ExpanderState extends Live {
    func onInit() { this.open = this.widget.initiallyExpanded }
    func build(context) {
        me = this
        w = this.widget
        parts = [
            Item(title: w.title, subtitle: w.subtitle, leading: w.leading,
                trailing: Icon(this.open ? Icons.expand_less : Icons.expand_more),
                onTap: func() {
                    me.update(func() { me.open = not me.open })
                    if (w.onExpansionChanged != null) { w.onExpansionChanged(me.open) }
                })
        ]
        if (this.open) { parts.push(Col(children: w.children)) }
        return Col(mainSize: "min", cross: "stretch", children: parts)
    }
}

class Badge extends View {
    func init(label = null, child = null, backgroundColor = null, key = null) {
        super.init(key: key)
        this.label = label
        this.child = child
        this.backgroundColor = backgroundColor
    }
    func build(context) {
        cs = Theme.of(context).colorScheme
        if (this.child == null) { return this.dot(cs) }
        return Layers(clipBehavior: "none", children: [
            this.child,
            Pin(top: -6, right: -8, child: this.dot(cs))
        ])
    }
    func dot(cs) {
        bg = this.backgroundColor ?? cs.error
        if (this.label == null) {
            return Box(width: 8, height: 8, decoration: Look(color: bg, shape: "circle"))
        }
        return Box(
            constraints: Limits(minWidth: 16, minHeight: 16), padding: Insets.symmetric(horizontal: 4),
            alignment: Alignment.center, decoration: Look(color: bg, borderRadius: Corners.circular(8)),
            child: TextDefaults(style: Font(color: cs.onError, fontSize: 11), child: this.label))
    }
}

class TagBase extends View {
    func init(label, avatar = null, selected = False, onTap = null, onDeleted = null, backgroundColor = null,
              showCheck = False, key = null) {
        super.init(key: key)
        this.label = label
        this.avatar = avatar
        this.selected = selected
        this.onTap = onTap
        this.onDeleted = onDeleted
        this.backgroundColor = backgroundColor
        this.showCheck = showCheck
    }
    func build(context) {
        cs = Theme.of(context).colorScheme
        row = []
        if (this.selected and this.showCheck) { row.push(Icon(Icons.check, size: 18, color: cs.onSecondaryContainer)) }
        elif (this.avatar != null) { row.push(this.avatar) }
        row.push(TextDefaults(
            style: Font(fontSize: 14, fontWeight: 500, color: this.selected ? cs.onSecondaryContainer : cs.onSurfaceVariant),
            child: this.label))
        if (this.onDeleted != null) {
            row.push(Touch(onTap: this.onDeleted, child: Icon(Icons.close, size: 18, color: cs.onSurfaceVariant)))
        }
        body = Box(
            padding: Insets.symmetric(horizontal: 12, vertical: 6),
            decoration: Look(
                color: this.selected ? cs.secondaryContainer : this.backgroundColor,
                borderRadius: Corners.circular(8),
                border: this.selected ? null : Border.all(color: cs.outlineVariant, width: 1)),
            child: Row(mainSize: "min", gap: 8, children: row))
        if (this.onTap == null) { return body }
        return Tap(onTap: this.onTap, borderRadius: Corners.circular(8), child: body)
    }
}
