class RawNode extends RenderWidget {
    func init(node, key = null) {
        super.init(key: key)
        this.node = node
    }
    func toNode(context) { return this.node }
}

class InputState extends Live {
    func onInit() {
        w = this.widget
        this.ctrl = w.controller == null ? TextController(text: w.initialValue) : w.controller
        this.touched = False
        this.registerWithForm()
    }
    func onWidgetChange(oldWidget) {
        if (this.widget.controller != null) { this.ctrl = this.widget.controller }
    }
    func onExit() {
        form = this.formState()
        if (form != null) { form.unregister(this.context.path) }
    }
    func formState() {
        scope = this.context.findInherited("FormScope")
        if (scope == null) { return null }
        return scope.state
    }
    func registerWithForm() {
        form = this.formState()
        if (form != null) { form.register(this.context.path, this) }
    }
    func currentError() {
        w = this.widget
        if (w.validator == null) { return null }
        if (this.touched or w.autovalidate) { return w.validator(this.ctrl.text) }
        return null
    }
    func validate() {
        this.touched = True
        if (this.widget.validator == null) { return True }
        return this.widget.validator(this.ctrl.text) == null
    }
    func save() {
        if (this.widget.onSaved != null) { this.widget.onSaved(this.ctrl.text) }
    }
    func reset() {
        this.ctrl.text = this.widget.initialValue == null ? "" : this.widget.initialValue
        this.touched = False
    }
    func build(context) {
        w = this.widget
        this.registerWithForm()
        me = this
        d = w.decoration
        ctrl = this.ctrl
        changed = func(v) {
            ctrl.text = v
            me.touched = True
            if (w.onChange != null) { w.onChange(v) }
            ctrl.notifyListeners()
        }
        submitted = func() {
            if (w.onSubmit != null) { w.onSubmit(ctrl.text) }
        }
        err = d.errorText ?? this.currentError()
        kb = w.keyboardType
        if (w.maxLines != 1 and kb == null) { kb = "multiline" }
        node = {
            type: "textField", value: ctrl.text,
            hint: d.hintText, label: d.labelText, helper: d.helperText, error: err,
            prefix: context.build(d.prefixIcon, "pre"), suffix: context.build(d.suffixIcon, "suf"),
            prefixText: d.prefixText, suffixText: d.suffixText,
            obscure: w.obscureText ? True : null, keyboard: kb, action: w.textInputAction,
            maxLines: w.maxLines, minLines: w.minLines, maxLength: w.maxLength,
            enabled: w.enabled, readOnly: w.readOnly ? True : null, autofocus: w.autofocus ? True : null,
            style: u_style(w.style), textAlign: w.textAlign, filled: d.filled, fillColor: u_color(d.fillColor),
            counter: d.counterText, dense: d.isDense ? True : null,
            capitalization: w.textCapitalization,
            onChanged: context.on(changed, "str"), onSubmitted: context.on(submitted, "void"),
            onTap: context.on(w.onTap, "void")
        }
        if (d.border != null) {
            node.border = d.border.kind
            if (d.border.borderRadius != null) { node.radius = u_radius(d.border.borderRadius) }
        }
        return RawNode(node)
    }
}

class FormScope extends Provider {
    func init(state, child = null, key = null) {
        super.init(child: child, key: key)
        this.state = state
    }
}

class Form extends LiveView {
    func init(child = null, key = null, autovalidateMode = null) {
        super.init(key: key)
        this.child = child
        this.formKey = key
    }
    func createState() { return FormState() }
    func of(context) {
        s = context.findInherited("FormScope")
        return s == null ? null : s.state
    }
}

class FormState extends Live {
    func onInit() {
        this.fields = {}
        this.attach()
    }
    func attach() {
        k = this.widget.formKey
        if (k != null and typeof(k) == "instance" and class_name(k) == "GlobalKey") {
            k.currentState = this
            k.currentContext = this.context
        }
    }
    func register(path, field) { this.fields[path] = field }
    func unregister(path) { this.fields.remove(path) }
    func validate() {
        ok = True
        for p in this.fields.keys() {
            if (not this.fields[p].validate()) { ok = False }
        }
        RT.dirty = True
        return ok
    }
    func save() {
        for p in this.fields.keys() { this.fields[p].save() }
    }
    func reset() {
        for p in this.fields.keys() { this.fields[p].reset() }
        RT.dirty = True
    }
    func build(context) {
        this.attach()
        return FormScope(state: this, child: this.widget.child)
    }
}

class ScreenState {
    func openDrawer() { RT.command({cmd: "drawer", op: "open", side: "start"}) }
    func closeDrawer() { RT.command({cmd: "drawer", op: "close", side: "start"}) }
    func openEndDrawer() { RT.command({cmd: "drawer", op: "open", side: "end"}) }
    func closeEndDrawer() { RT.command({cmd: "drawer", op: "close", side: "end"}) }
    func hasDrawer() { return RT.scaffold_info.drawer }
}

class Screen extends RenderWidget {
    func init(body = null, topBar = null, sideMenu = null, endMenu = null, bottomBar = null,
              actionButton = null, floatingActionButtonLocation = null, backgroundColor = null,
              bottomSheet = null, resizeToAvoidBottomInset = True, extendBody = False,
              extendBodyBehindAppBar = False, key = null) {
        super.init(key: key)
        this.body = body
        this.topBar = topBar
        this.sideMenu = sideMenu
        this.endMenu = endMenu
        this.bottomBar = bottomBar
        this.actionButton = actionButton
        this.floatingActionButtonLocation = floatingActionButtonLocation
        this.backgroundColor = backgroundColor
        this.bottomSheet = bottomSheet
        this.resizeToAvoidBottomInset = resizeToAvoidBottomInset
        this.extendBody = extendBody
        this.extendBodyBehindAppBar = extendBodyBehindAppBar
    }
    func of(context) { return ScreenState() }
    func toNode(context) {
        th = Theme.of(context)
        RT.scaffold_info = {drawer: this.sideMenu != null, endDrawer: this.endMenu != null}
        node = {
            type: "scaffold",
            bg: u_color(this.backgroundColor ?? th.scaffoldBackgroundColor),
            fabLocation: this.floatingActionButtonLocation,
            resizeInset: this.resizeToAvoidBottomInset,
            extendBody: this.extendBody ? True : null,
            extendBehindAppBar: this.extendBodyBehindAppBar ? True : null
        }
        node.appBar = context.build(this.topBar, "appbar")
        node.body = context.build(this.body, "body")
        node.drawer = context.build(this.sideMenu, "drawer")
        node.endDrawer = context.build(this.endMenu, "enddrawer")
        node.bottomNav = context.build(this.bottomBar, "bottomnav")
        node.fab = context.build(this.actionButton, "fab")
        node.bottomSheet = context.build(this.bottomSheet, "sheet")
        return node
    }
}
RT.scaffold_info = {drawer: False, endDrawer: False}

class TopBar extends RenderWidget {
    func init(title = null, leading = null, actions = null, backgroundColor = null, foregroundColor = null,
              elevation = null, centerTitle = null, bottom = null, automaticallyImplyLeading = True,
              toolbarHeight = null, titleTextStyle = null, flexibleSpace = null, key = null) {
        super.init(key: key)
        this.title = title
        this.leading = leading
        this.actions = actions
        this.backgroundColor = backgroundColor
        this.foregroundColor = foregroundColor
        this.elevation = elevation
        this.centerTitle = centerTitle
        this.bottom = bottom
        this.automaticallyImplyLeading = automaticallyImplyLeading
        this.toolbarHeight = toolbarHeight
        this.titleTextStyle = titleTextStyle
    }
    func toNode(context) {
        th = Theme.of(context)
        at = th.appBarTheme
        node = {
            type: "appBar",
            bg: u_color(this.backgroundColor ?? at.backgroundColor),
            fg: u_color(this.foregroundColor ?? at.foregroundColor),
            elevation: this.elevation ?? at.elevation,
            centerTitle: this.centerTitle ?? at.centerTitle,
            height: this.toolbarHeight
        }
        titleW = this.title
        if (titleW != null and (this.titleTextStyle != null or at.titleTextStyle != null)) {
            titleW = TextDefaults(style: this.titleTextStyle ?? at.titleTextStyle, child: titleW)
        }
        node.title = context.build(titleW, "title")
        if (this.leading != null) {
            node.leading = context.build(this.leading, "leading")
        } elif (this.automaticallyImplyLeading) {
            if (RT.scaffold_info.drawer) {
                node.autoLeading = "menu"
            } elif (len(RT.routes) > 1) {
                node.autoLeading = "back"
                node.onBack = context.on(func() { RT.nav.pop(null) }, "void")
            }
        }
        node.actions = context.buildAll(this.actions)
        node.bottom = context.build(this.bottom, "bottom")
        return node
    }
}

class SideMenu extends RenderWidget {
    func init(child = null, backgroundColor = null, width = null, key = null) {
        super.init(key: key)
        this.child = child
        this.backgroundColor = backgroundColor
        this.width = width
    }
    func toNode(context) {
        return {type: "drawer", bg: u_color(this.backgroundColor), width: this.width, child: context.build(this.child, 0)}
    }
}

class SideMenuHeader extends View {
    func init(child = null, decoration = null, padding = null, margin = null, key = null) {
        super.init(key: key)
        this.child = child
        this.decoration = decoration
        this.padding = padding
    }
    func build(context) {
        cs = Theme.of(context).colorScheme
        return Box(
            width: INFINITY, height: 160, alignment: Alignment.bottomLeft,
            padding: this.padding == null ? Insets.all(16) : this.padding,
            decoration: this.decoration == null ? Look(color: cs.primaryContainer) : this.decoration,
            child: TextDefaults(style: Font(fontSize: 22, color: cs.onPrimaryContainer), child: this.child))
    }
}

class AccountHeader extends View {
    func init(accountName = null, accountEmail = null, currentAccountPicture = null, decoration = null, key = null) {
        super.init(key: key)
        this.accountName = accountName
        this.accountEmail = accountEmail
        this.currentAccountPicture = currentAccountPicture
        this.decoration = decoration
    }
    func build(context) {
        cs = Theme.of(context).colorScheme
        return Box(
            width: INFINITY, padding: Insets.all(16), alignment: Alignment.bottomLeft,
            decoration: this.decoration == null ? Look(color: cs.primaryContainer) : this.decoration,
            child: Col(cross: "start", mainSize: "min", gap: 8, children: [
                this.currentAccountPicture,
                TextDefaults(style: Font(fontSize: 16, fontWeight: 500, color: cs.onPrimaryContainer), child: this.accountName),
                TextDefaults(style: Font(fontSize: 13, color: cs.onPrimaryContainer), child: this.accountEmail)
            ]))
    }
}

class BottomItem {
    func init(icon, label = null, activeIcon = null, backgroundColor = null) {
        this.icon = icon
        this.label = label
        this.activeIcon = activeIcon
    }
}

func u_icon_name(w) {
    if (w == null) { return null }
    if (typeof(w) == "string") { return w }
    if (typeof(w) == "instance" and class_name(w) == "Icon") { return w.icon }
    return null
}

class BottomBar extends RenderWidget {
    func init(items, currentIndex = 0, onTap = null, type = null, selectedItemColor = null,
              unselectedItemColor = null, backgroundColor = null, key = null) {
        super.init(key: key)
        this.items = items
        this.currentIndex = currentIndex
        this.onTap = onTap
        this.selectedItemColor = selectedItemColor
        this.backgroundColor = backgroundColor
    }
    func toNode(context) {
        its = []
        for it in this.items {
            its.push({icon: u_icon_name(it.icon), activeIcon: u_icon_name(it.activeIcon), label: it.label})
        }
        return {type: "navBar", items: its, selected: this.currentIndex, bg: u_color(this.backgroundColor),
                color: u_color(this.selectedItemColor), onChanged: context.on(this.onTap, "int")}
    }
}

class NavItem {
    func init(icon, label, selectedIcon = null) {
        this.icon = icon
        this.label = label
        this.selectedIcon = selectedIcon
    }
}

class NavBar extends RenderWidget {
    func init(destinations, selectedIndex = 0, onDestinationSelected = null, backgroundColor = null, key = null) {
        super.init(key: key)
        this.destinations = destinations
        this.selectedIndex = selectedIndex
        this.onDestinationSelected = onDestinationSelected
        this.backgroundColor = backgroundColor
    }
    func toNode(context) {
        its = []
        for it in this.destinations {
            its.push({icon: u_icon_name(it.icon), activeIcon: u_icon_name(it.selectedIcon), label: it.label})
        }
        return {type: "navBar", items: its, selected: this.selectedIndex, bg: u_color(this.backgroundColor),
                onChanged: context.on(this.onDestinationSelected, "int")}
    }
}

class TabLabel {
    func init(text = null, icon = null, child = null) {
        this.text = text
        this.icon = icon
        this.child = child
    }
}

class TabController extends Notifier {
    func init(length, vsync = null, initialIndex = 0) {
        super.init()
        this.length = length
        this.index = initialIndex
    }
    func animateTo(i, duration = null, curve = null) {
        this.index = u_clamp(i, 0, this.length - 1)
        this.notifyListeners()
    }
}

class TabScope extends Provider {
    func init(controller, child = null, key = null) {
        super.init(child: child, key: key)
        this.controller = controller
    }
}

class TabHost extends LiveView {
    func init(length, child = null, initialIndex = 0, key = null) {
        super.init(key: key)
        this.length = length
        this.child = child
        this.initialIndex = initialIndex
    }
    func createState() { return TabHostState() }
    func of(context) {
        s = context.findInherited("TabScope")
        return s == null ? null : s.controller
    }
}
class TabHostState extends Live {
    func onInit() {
        this.ctl = TabController(this.widget.length, initialIndex: this.widget.initialIndex)
    }
    func build(context) {
        return TabScope(controller: this.ctl, child: this.widget.child)
    }
}

class Tabs extends RenderWidget {
    func init(tabs, controller = null, isScrollable = False, onTap = null, labelColor = null,
              indicatorColor = null, key = null) {
        super.init(key: key)
        this.tabs = tabs
        this.controller = controller
        this.isScrollable = isScrollable
        this.onTap = onTap
        this.labelColor = labelColor
        this.indicatorColor = indicatorColor
    }
    func toNode(context) {
        ctl = this.controller ?? TabHost.of(context)
        labels = []
        for t in this.tabs {
            labels.push({text: t.text, icon: u_icon_name(t.icon), child: context.build(t.child, "t" + str(len(labels)))})
        }
        cb = this.onTap
        handler = func(i) {
            if (ctl != null) { ctl.animateTo(i) }
            if (cb != null) { cb(i) }
        }
        return {type: "tabBar", labels: labels, selected: ctl == null ? 0 : ctl.index, scrollable: this.isScrollable,
                color: u_color(this.labelColor), indicator: u_color(this.indicatorColor),
                onChanged: context.on(handler, "int")}
    }
}

class TabPages extends RenderWidget {
    func init(children, controller = null, physics = null, key = null) {
        super.init(key: key)
        this.children = children
        this.controller = controller
        this.physics = physics
    }
    func toNode(context) {
        ctl = this.controller ?? TabHost.of(context)
        handler = func(i) { if (ctl != null) { ctl.animateTo(i) } }
        return {type: "pageView", dir: "horizontal", index: ctl == null ? 0 : ctl.index,
                onChanged: context.on(handler, "int"), children: context.buildAll(this.children)}
    }
}

class Alert extends View {
    func init(title = null, content = null, actions = null, backgroundColor = null, icon = null, key = null) {
        super.init(key: key)
        this.title = title
        this.content = content
        this.actions = actions
        this.backgroundColor = backgroundColor
        this.icon = icon
    }
    func build(context) {
        th = Theme.of(context)
        cs = th.colorScheme
        parts = []
        if (this.icon != null) { parts.push(Pad(padding: Insets.only(bottom: 16), child: this.icon)) }
        if (this.title != null) {
            parts.push(Pad(padding: Insets.only(bottom: 16),
                child: TextDefaults(style: th.textTheme.headlineSmall.copyWith(color: cs.onSurface), child: this.title)))
        }
        if (this.content != null) {
            parts.push(Weighted(child: Scroll(
                child: TextDefaults(style: th.textTheme.bodyMedium.copyWith(color: cs.onSurfaceVariant), child: this.content))))
        }
        if (this.actions != null and len(this.actions) > 0) {
            parts.push(Pad(padding: Insets.only(top: 24), child: Row(main: "end", gap: 8, children: this.actions)))
        }
        return Box(
            padding: Insets.all(24), constraints: Limits(minWidth: 280, maxWidth: 560),
            decoration: Look(color: this.backgroundColor ?? cs.surface.lighten(0.04), borderRadius: Corners.circular(28)),
            child: Col(mainSize: "min", cross: "stretch", children: parts))
    }
}

class ChoiceDialog extends View {
    func init(title = null, children = null, key = null) {
        super.init(key: key)
        this.title = title
        this.children = children
    }
    func build(context) {
        return Alert(title: this.title, content: Col(mainSize: "min", cross: "stretch", children: this.children == null ? [] : this.children))
    }
}

class ChoiceOption extends View {
    func init(onTap = null, child = null, key = null) {
        super.init(key: key)
        this.onTap = onTap
        this.child = child
    }
    func build(context) {
        return Tap(onTap: this.onTap, child: Pad(padding: Insets.symmetric(horizontal: 0, vertical: 12), child: this.child))
    }
}

class Dialog extends View {
    func init(child = null, backgroundColor = null, key = null) {
        super.init(key: key)
        this.child = child
        this.backgroundColor = backgroundColor
    }
    func build(context) {
        cs = Theme.of(context).colorScheme
        return Box(
            constraints: Limits(maxWidth: 560), clipBehavior: "antiAlias",
            decoration: Look(color: this.backgroundColor ?? cs.surface.lighten(0.04), borderRadius: Corners.circular(28)),
            child: this.child)
    }
}

func showDialog(context = null, builder = null, barrierDismissible = True, barrierColor = null, onResult = null) {
    return RT.open_overlay("dialog", builder, {dismissible: barrierDismissible, barrierColor: barrierColor, onResult: onResult})
}

func showSheet(context = null, builder = null, isScrollControlled = False, backgroundColor = null,
                          showDragHandle = False, isDismissible = True, onResult = null) {
    return RT.open_overlay("bottomSheet", builder, {dismissible: isDismissible, isScrollControlled: isScrollControlled,
                           backgroundColor: backgroundColor, showDragHandle: showDragHandle, onResult: onResult})
}

class NoticeAction {
    func init(label, onTap = null, textColor = null) {
        this.label = label
        this.onTap = onTap
        this.textColor = textColor
    }
}

class Notice extends View {
    func init(content, action = null, duration = null, backgroundColor = null, key = null) {
        super.init(key: key)
        this.content = content
        this.action = action
        this.duration = duration
        this.backgroundColor = backgroundColor
    }
    func build(context) {
        cs = Theme.of(context).colorScheme
        fg = cs.onInverseSurface
        row = [Grow(child: TextDefaults(style: Font(fontSize: 14, color: fg), child: this.content))]
        if (this.action != null) {
            act = this.action
            row.push(FlatButton(onTap: func() {
                if (act.onTap != null) { act.onTap() }
                RT.close_overlays_of_kind("snackbar")
            }, child: Text(act.label, style: Font(color: act.textColor ?? cs.primaryContainer))))
        }
        return Box(
            margin: Insets.all(12), padding: Insets.symmetric(horizontal: 16, vertical: 6),
            constraints: Limits(minHeight: 48),
            decoration: Look(color: this.backgroundColor ?? cs.inverseSurface, borderRadius: Corners.circular(4),
                                      boxShadow: [Shadow(color: Colors.black26, blurRadius: 6, offset: Offset(dx: 0, dy: 2))]),
            child: Row(gap: 8, children: row))
    }
}

class NoticesState {
    func notify(snackBar) {
        sb = snackBar
        return RT.open_overlay("snackbar", func(ctx) { return sb }, {duration: sb.duration, dismissible: False,
                                                                       backgroundColor: null, onResult: null})
    }
    func hideCurrentSnackBar() { RT.close_overlays_of_kind("snackbar") }
    func clearSnackBars() { RT.close_overlays_of_kind("snackbar") }
}
class Notices {
    func of(context) { return NoticesState() }
}

func showAboutDialog(context = null, applicationName = "", applicationVersion = "") {
    return showDialog(context: context, builder: func(ctx) {
        return Alert(title: Text(applicationName), content: Text(applicationVersion),
            actions: [FlatButton("OK", onTap: func() { RT.nav.pop(null) })])
    })
}
