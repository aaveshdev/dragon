        this.suffixText = suffixText
        this.border = border
        this.filled = filled
        this.fillColor = fillColor
        this.isDense = isDense
    }
}

class Input extends LiveView {
    func init(controller = null, decoration = null, obscureText = False, keyboardType = null, textInputAction = null,
              maxLines = 1, minLines = null, maxLength = null, onChange = null, onSubmit = null, enabled = True,
              readOnly = False, autofocus = False, style = null, textAlign = null, initialValue = null,
