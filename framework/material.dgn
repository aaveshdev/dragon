import "dragon/core" as *
import "dragon/runtime" as *
import "dragon/widgets" as *

func u_eq(a, b) {
    if (typeof(a) == "instance" or typeof(b) == "instance") { return same(a, b) }
    return a == b
}

func u_hue_to_rgb(p, q, t) {
    k = t
    if (k < 0) { k = k + 1 }
    if (k > 1) { k = k - 1 }
    if (k < 1 / 6) { return p + (q - p) * 6 * k }
    if (k < 1 / 2) { return q }
    if (k < 2 / 3) { return p + (q - p) * (2 / 3 - k) * 6 }
    return p
}

func u_hsl(h, s, l) {
    hh = (h % 360) / 360
    if (hh < 0) { hh = hh + 1 }
    if (s <= 0) {
        v = round_int(l * 255)
        return Color.fromARGB(255, v, v, v)
    }
    q = l < 0.5 ? l * (1 + s) : l + s - l * s
    p = 2 * l - q
    return Color.fromARGB(255,
        round_int(u_hue_to_rgb(p, q, hh + 1 / 3) * 255),
        round_int(u_hue_to_rgb(p, q, hh) * 255),
        round_int(u_hue_to_rgb(p, q, hh - 1 / 3) * 255))
}

func u_to_hsl(c) {
    r = c.r / 255
    g = c.g / 255
    b = c.b / 255
    mx = max(r, max(g, b))
    mn = min(r, min(g, b))
    l = (mx + mn) / 2
    h = 0
    s = 0
    d = mx - mn
    if (d > 0.00001) {
        s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn)
        if (mx == r) { h = (g - b) / d + (g < b ? 6 : 0) }
        elif (mx == g) { h = (b - r) / d + 2 }
        else { h = (r - g) / d + 4 }
        h = h * 60
    }
    return [h, s, l]
}

class Palette {
    func init(primary, onPrimary = null, primaryContainer = null, onPrimaryContainer = null,
              secondary = null, onSecondary = null, secondaryContainer = null, onSecondaryContainer = null,
              tertiary = null, error = null, onError = null, surface = null, onSurface = null,
              surfaceVariant = null, onSurfaceVariant = null, outline = null, outlineVariant = null,
              inverseSurface = null, onInverseSurface = null, background = null, onBackground = null,
              brightness = "light") {
        this.brightness = brightness
        this.primary = primary
        this.onPrimary = onPrimary ?? Colors.white
        this.primaryContainer = primaryContainer ?? primary.lighten(0.7)
        this.onPrimaryContainer = onPrimaryContainer ?? primary.darken(0.6)
        this.secondary = secondary ?? primary
        this.onSecondary = onSecondary ?? Colors.white
        this.secondaryContainer = secondaryContainer ?? primary.lighten(0.8)
        this.onSecondaryContainer = onSecondaryContainer ?? primary.darken(0.6)
        this.tertiary = tertiary ?? primary
        this.error = error ?? Color(4290190364)
        this.onError = onError ?? Colors.white
        this.surface = surface ?? Colors.white
        this.onSurface = onSurface ?? Colors.black
        this.surfaceVariant = surfaceVariant ?? Colors.grey.shade200
        this.onSurfaceVariant = onSurfaceVariant ?? Colors.grey.shade700
        this.outline = outline ?? Colors.grey.shade500
        this.outlineVariant = outlineVariant ?? Colors.grey.shade300
        this.inverseSurface = inverseSurface ?? Colors.grey.shade900
        this.onInverseSurface = onInverseSurface ?? Colors.white
        this.background = background ?? this.surface
        this.onBackground = onBackground ?? this.onSurface
    }

    func fromSeed(seedColor, brightness = "light") {
        hsl = u_to_hsl(seedColor)
        h = hsl[0]
        s = u_clamp(hsl[1], 0.30, 0.90)
        if (brightness == "dark") {
            return Palette(
                primary: u_hsl(h, s, 0.78), onPrimary: u_hsl(h, s, 0.18),
                primaryContainer: u_hsl(h, s * 0.8, 0.28), onPrimaryContainer: u_hsl(h, s, 0.90),
                secondary: u_hsl(h, s * 0.35, 0.78), onSecondary: u_hsl(h, s * 0.35, 0.18),
                secondaryContainer: u_hsl(h, s * 0.30, 0.28), onSecondaryContainer: u_hsl(h, s * 0.35, 0.90),
                tertiary: u_hsl(h + 60, s * 0.5, 0.78),
                error: Color(4294948011), onError: Color(4285071365),
                surface: u_hsl(h, 0.10, 0.10), onSurface: u_hsl(h, 0.08, 0.90),
                surfaceVariant: u_hsl(h, 0.10, 0.25), onSurfaceVariant: u_hsl(h, 0.10, 0.78),
                outline: u_hsl(h, 0.06, 0.60), outlineVariant: u_hsl(h, 0.08, 0.30),
                inverseSurface: u_hsl(h, 0.08, 0.90), onInverseSurface: u_hsl(h, 0.10, 0.15),
                brightness: "dark")
        }
        return Palette(
            primary: u_hsl(h, s, 0.40), onPrimary: Colors.white,
            primaryContainer: u_hsl(h, s * 0.9, 0.90), onPrimaryContainer: u_hsl(h, s, 0.12),
            secondary: u_hsl(h, s * 0.35, 0.40), onSecondary: Colors.white,
            secondaryContainer: u_hsl(h, s * 0.35, 0.90), onSecondaryContainer: u_hsl(h, s * 0.4, 0.12),
            tertiary: u_hsl(h + 60, s * 0.5, 0.40),
            error: Color(4290190364), onError: Colors.white,
            surface: u_hsl(h, 0.20, 0.98), onSurface: u_hsl(h, 0.08, 0.10),
            surfaceVariant: u_hsl(h, 0.15, 0.90), onSurfaceVariant: u_hsl(h, 0.10, 0.30),
            outline: u_hsl(h, 0.06, 0.46), outlineVariant: u_hsl(h, 0.10, 0.80),
            inverseSurface: u_hsl(h, 0.08, 0.20), onInverseSurface: u_hsl(h, 0.10, 0.95),
            brightness: "light")
    }

    func light(primary = null) {
        return Palette.fromSeed(primary == null ? Colors.indigo : primary, "light")
    }
    func dark(primary = null) {
        return Palette.fromSeed(primary == null ? Colors.indigo : primary, "dark")
    }

    func toJson() {
        return {
            dark: this.brightness == "dark",
            primary: u_color(this.primary), onPrimary: u_color(this.onPrimary),
            primaryContainer: u_color(this.primaryContainer), onPrimaryContainer: u_color(this.onPrimaryContainer),
            secondary: u_color(this.secondary), onSecondary: u_color(this.onSecondary),
            secondaryContainer: u_color(this.secondaryContainer), onSecondaryContainer: u_color(this.onSecondaryContainer),
            tertiary: u_color(this.tertiary),
            error: u_color(this.error), onError: u_color(this.onError),
            surface: u_color(this.surface), onSurface: u_color(this.onSurface),
            surfaceVariant: u_color(this.surfaceVariant), onSurfaceVariant: u_color(this.onSurfaceVariant),
            outline: u_color(this.outline), outlineVariant: u_color(this.outlineVariant),
            inverseSurface: u_color(this.inverseSurface), onInverseSurface: u_color(this.onInverseSurface),
            background: u_color(this.background), onBackground: u_color(this.onBackground)
        }
    }
}

class FontSet {
    func init() {
        this.displayLarge = Font(fontSize: 57, height: 1.12)
        this.displayMedium = Font(fontSize: 45, height: 1.16)
        this.displaySmall = Font(fontSize: 36, height: 1.22)
        this.headlineLarge = Font(fontSize: 32, height: 1.25)
        this.headlineMedium = Font(fontSize: 28, height: 1.29)
        this.headlineSmall = Font(fontSize: 24, height: 1.33)
        this.titleLarge = Font(fontSize: 22, height: 1.27)
        this.titleMedium = Font(fontSize: 16, fontWeight: 500, height: 1.5)
        this.titleSmall = Font(fontSize: 14, fontWeight: 500, height: 1.43)
        this.bodyLarge = Font(fontSize: 16, height: 1.5)
        this.bodyMedium = Font(fontSize: 14, height: 1.43)
        this.bodySmall = Font(fontSize: 12, height: 1.33)
        this.labelLarge = Font(fontSize: 14, fontWeight: 500, height: 1.43)
        this.labelMedium = Font(fontSize: 12, fontWeight: 500, height: 1.33)
        this.labelSmall = Font(fontSize: 11, fontWeight: 500, height: 1.45)
    }
}

class TopBarTheme {
    func init(backgroundColor = null, foregroundColor = null, elevation = null, centerTitle = null, titleTextStyle = null) {
        this.backgroundColor = backgroundColor
        this.foregroundColor = foregroundColor
        this.elevation = elevation
        this.centerTitle = centerTitle
        this.titleTextStyle = titleTextStyle
    }
}

class ThemeSpec {
    func init(colorScheme = null, primarySwatch = null, primaryColor = null, brightness = "light",
              useMaterial3 = True, scaffoldBackgroundColor = null, appBarTheme = null, fontFamily = null,
              textTheme = null, cardColor = null, dividerColor = null, visualDensity = null) {
        base = colorScheme
        if (base == null) {
            seed = primarySwatch ?? primaryColor ?? Colors.indigo
            base = Palette.fromSeed(seed, brightness)
        }
        this.colorScheme = base
        this.brightness = base.brightness
        this.useMaterial3 = useMaterial3
        this.primaryColor = base.primary
        this.scaffoldBackgroundColor = scaffoldBackgroundColor ?? base.surface
        this.appBarTheme = appBarTheme ?? TopBarTheme()
        this.fontFamily = fontFamily
        this.textTheme = textTheme ?? FontSet()
        this.cardColor = cardColor ?? (base.brightness == "dark" ? base.surface.lighten(0.06) : Colors.white)
        this.dividerColor = dividerColor ?? base.outlineVariant
    }
    func light() { return ThemeSpec(brightness: "light") }
    func dark() { return ThemeSpec(brightness: "dark") }
    func copyWith(colorScheme = null, scaffoldBackgroundColor = null, appBarTheme = null, fontFamily = null, textTheme = null) {
        return ThemeSpec(
            colorScheme: colorScheme ?? this.colorScheme,
            scaffoldBackgroundColor: scaffoldBackgroundColor ?? this.scaffoldBackgroundColor,
            appBarTheme: appBarTheme ?? this.appBarTheme,
            fontFamily: fontFamily ?? this.fontFamily,
            textTheme: textTheme ?? this.textTheme,
            useMaterial3: this.useMaterial3,
            cardColor: this.cardColor,
            dividerColor: this.dividerColor)
    }
    func toJson() {
        out = {
            scheme: this.colorScheme.toJson(),
            dark: this.colorScheme.brightness == "dark",
            background: u_color(this.scaffoldBackgroundColor),
            font: this.fontFamily,
            material3: this.useMaterial3,
            divider: u_color(this.dividerColor)
        }
        return out
    }
}

class Theme extends Provider {
    func init(data, child = null, key = null) {
        super.init(child: child, key: key)
        this.data = data
    }
    func of(context) {
        t = context.findInherited("Theme")
        if (t == null) {
            if (RT.fallback_theme == null) { RT.fallback_theme = ThemeSpec() }
            return RT.fallback_theme
        }
        return t.data
    }
}
RT.fallback_theme = null

class DisplayInfo {
    func init(m) {
        this.size = Size(width: m.width, height: m.height)
        this.devicePixelRatio = m.pixelRatio
        this.padding = Insets(left: m.left, top: m.top, right: m.right, bottom: m.bottom)
        this.viewPadding = this.padding
        this.viewInsets = Insets(left: 0, top: 0, right: 0, bottom: m.keyboard)
        this.platformBrightness = m.brightness
        this.textScaleFactor = m.textScale
        this.orientation = m.width > m.height ? "landscape" : "portrait"
        this.locale = m.locale
    }
}

class Display {
    func of(context) { return DisplayInfo(RT.media) }
    func sizeOf(context) { return Size(width: RT.media.width, height: RT.media.height) }
}

class App extends View {
    func init(home = null, routes = null, initialRoute = null, onGenerateRoute = null, onUnknownRoute = null,
              title = "", theme = null, darkTheme = null, themeMode = "system", builder = null,
              debugShowCheckedModeBanner = True, navigatorKey = null, locale = null, key = null) {
        super.init(key: key)
        this.home = home
        this.routes = routes
        this.initialRoute = initialRoute
        this.onGenerateRoute = onGenerateRoute
        this.onUnknownRoute = onUnknownRoute
        this.title = title
        this.theme = theme
        this.darkTheme = darkTheme
        this.themeMode = themeMode
        this.builder = builder
    }
    func build(context) {
        wantDark = this.themeMode == "dark" or (this.themeMode == "system" and RT.media.brightness == "dark")
        light = this.theme == null ? ThemeSpec() : this.theme
        chosen = light
        if (wantDark) {
            if (this.darkTheme != null) {
                chosen = this.darkTheme
            } else {
                chosen = ThemeSpec(brightness: "dark", colorScheme: Palette.fromSeed(light.colorScheme.primary, "dark"),
                                   fontFamily: light.fontFamily, useMaterial3: light.useMaterial3)
            }
        }
        RT.theme_json = chosen.toJson()
        RT.fallback_theme = chosen
        RT.title = this.title
        body = NavHost(app: this)
        if (this.builder != null) {
            nav = body
            body = Builder(builder: func(ctx) { return this.builder(ctx, nav) })
        }
        return Theme(data: chosen, child: TextDefaults(style: Font(), child: body))
    }
}

class StateValue {
    func init(value) { this.value = value }
}
class WidgetStateProperty {
    func all(value) { return StateValue(value) }
    func resolveWith(fn) { return StateValue(fn([])) }
}
MaterialStateProperty = WidgetStateProperty

func u_sv(x) {
    if (x == null) { return null }
    if (typeof(x) == "instance" and class_name(x) == "StateValue") { return x.value }
    return x
}

class ButtonLook {
    func init(backgroundColor = null, foregroundColor = null, padding = null, shape = null, elevation = null,
              minimumSize = null, side = null, textStyle = null, fixedSize = null) {
        this.backgroundColor = u_sv(backgroundColor)
        this.foregroundColor = u_sv(foregroundColor)
        this.padding = u_sv(padding)
        this.shape = u_sv(shape)
        this.elevation = u_sv(elevation)
        this.minimumSize = u_sv(minimumSize)
        this.side = u_sv(side)
        this.textStyle = u_sv(textStyle)
        this.fixedSize = u_sv(fixedSize)
    }
}

func u_style_from(backgroundColor, foregroundColor, padding, shape, elevation, minimumSize, side, textStyle, fixedSize) {
    return ButtonLook(backgroundColor: backgroundColor, foregroundColor: foregroundColor, padding: padding,
                       shape: shape, elevation: elevation, minimumSize: minimumSize, side: side,
                       textStyle: textStyle, fixedSize: fixedSize)
}

func u_button_node(context, variant, onTap, onLongPress, child, style, extra) {
    node = {
        type: "button", variant: variant, enabled: onTap != null,
        onPressed: context.on(onTap, "void"),
        onLongPress: context.on(onLongPress, "void"),
        child: context.build(child, 0)
    }
    if (style != null) {
        node.bg = u_color(style.backgroundColor)
        node.fg = u_color(style.foregroundColor)
        node.padding = u_ins(style.padding)
        node.elevation = style.elevation
        if (style.shape != null) { node.shape = u_shape(style.shape) }
        if (style.minimumSize != null) {
            node.minWidth = style.minimumSize.width
            node.minHeight = style.minimumSize.height
        }
        if (style.fixedSize != null) {
            node.width = style.fixedSize.width
            node.height = style.fixedSize.height
        }
        if (style.side != null) {
            node.borderColor = u_color(style.side.color)
            node.borderWidth = style.side.width
        }
        if (style.textStyle != null) { node.textStyle = u_style(style.textStyle) }
    }
    if (extra != null) {
        for k in extra.keys() { node[k] = extra[k] }
    }
    return node
}

class Button extends RenderWidget {
    func init(label = null, onTap = null, kind = "raised", icon = null, child = null, style = null, onLongPress = null, key = null) {
        super.init(key: key)
        if (typeof(icon) == "string") { icon = Icon(icon) }
        this.label = label
        this.onTap = onTap
        this.kind = kind
        this.icon = icon
        this.style = style
        this.onLongPress = onLongPress
        if (child != null) {
            this.child = child
        } else if (icon != null and label != null) {
            this.child = Row([icon, Text(label)], mainSize: "min", gap: 8)
        } else if (label != null) {
            this.child = Text(label)
        } else {
            this.child = icon
        }
    }
    func styleFrom(backgroundColor = null, foregroundColor = null, padding = null, shape = null, elevation = null,
                   minimumSize = null, side = null, textStyle = null, fixedSize = null) {
        return u_style_from(backgroundColor, foregroundColor, padding, shape, elevation, minimumSize, side, textStyle, fixedSize)
    }
    func variantName() {
        k = this.kind
        if (k == "solid" or k == "filled") { return "filled" }
        if (k == "tonal") { return "tonal" }
        if (k == "line" or k == "outlined") { return "outlined" }
        if (k == "flat" or k == "text") { return "text" }
        return "elevated"
    }
    func toNode(context) {
        return u_button_node(context, this.variantName(), this.onTap, this.onLongPress, this.child, this.style, null)
    }
}

class SolidButton extends Button {
    func init(label = null, onTap = null, icon = null, child = null, style = null, onLongPress = null, key = null) {
        super.init(label, onTap: onTap, kind: "solid", icon: icon, child: child, style: style, onLongPress: onLongPress, key: key)
    }
}
class LineButton extends Button {
    func init(label = null, onTap = null, icon = null, child = null, style = null, onLongPress = null, key = null) {
        super.init(label, onTap: onTap, kind: "line", icon: icon, child: child, style: style, onLongPress: onLongPress, key: key)
    }
}
class FlatButton extends Button {
    func init(label = null, onTap = null, icon = null, child = null, style = null, onLongPress = null, key = null) {
        super.init(label, onTap: onTap, kind: "flat", icon: icon, child: child, style: style, onLongPress: onLongPress, key: key)
    }
}

class IconButton extends RenderWidget {
    func init(onTap, icon = null, color = null, iconSize = null, tooltip = null, style = null, key = null) {
        super.init(key: key)
        this.onTap = onTap
        this.icon = icon
        this.color = color
        this.iconSize = iconSize
        this.style = style
        this.variant = "icon"
    }
    func filled(onTap, icon = null, color = null, iconSize = null, key = null) {
        b = IconButton(onTap, icon: icon, color: color, iconSize: iconSize, key: key)
        b.variant = "iconFilled"
        return b
    }
    func tonal(onTap, icon = null, color = null, iconSize = null, key = null) {
        b = IconButton(onTap, icon: icon, color: color, iconSize: iconSize, key: key)
        b.variant = "iconTonal"
        return b
    }
    func outlined(onTap, icon = null, color = null, iconSize = null, key = null) {
        b = IconButton(onTap, icon: icon, color: color, iconSize: iconSize, key: key)
        b.variant = "iconOutlined"
        return b
    }
    func toNode(context) {
        extra = {fg: u_color(this.color), iconSize: this.iconSize}
        return u_button_node(context, this.variant, this.onTap, null, this.icon, this.style, extra)
    }
}

class ActionButton extends RenderWidget {
    func init(onTap, child = null, backgroundColor = null, foregroundColor = null, mini = False, tooltip = null,
              shape = null, label = null, heroTag = null, elevation = null, key = null) {
        super.init(key: key)
        this.onTap = onTap
        this.child = child
        this.backgroundColor = backgroundColor
        this.foregroundColor = foregroundColor
        this.mini = mini
        this.shape = shape
        this.label = label
        this.variant = mini ? "fabSmall" : "fab"
        this.elevation = elevation
    }
    func small(onTap, child = null, backgroundColor = null, foregroundColor = null, key = null) {
        f = ActionButton(onTap, child: child, backgroundColor: backgroundColor, foregroundColor: foregroundColor, key: key)
        f.variant = "fabSmall"
        return f
    }
    func large(onTap, child = null, backgroundColor = null, foregroundColor = null, key = null) {
        f = ActionButton(onTap, child: child, backgroundColor: backgroundColor, foregroundColor: foregroundColor, key: key)
        f.variant = "fabLarge"
        return f
    }
    func extended(onTap, label, icon = null, backgroundColor = null, foregroundColor = null, key = null) {
        f = ActionButton(onTap, child: icon, backgroundColor: backgroundColor, foregroundColor: foregroundColor, key: key)
        f.label = label
        f.variant = "fabExtended"
        return f
    }
    func toNode(context) {
        node = {
            type: "button", variant: this.variant, enabled: True,
            onPressed: context.on(this.onTap, "void"),
            bg: u_color(this.backgroundColor), fg: u_color(this.foregroundColor),
            elevation: this.elevation, shape: u_shape(this.shape),
            child: context.build(this.child, 0)
        }
        if (this.label != null) { node.label = context.build(this.label, 1) }
        return node
    }
}

class Surface extends RenderWidget {
    func init(child = null, color = null, elevation = 0, borderRadius = null, shape = null, type = "canvas",
              padding = null, key = null) {
        super.init(key: key)
        this.child = child
        this.color = color
        this.elevation = elevation
        this.borderRadius = borderRadius
        this.shape = shape
        this.padding = padding
    }
    func toNode(context) {
        th = Theme.of(context)
        node = {
            type: "container", color: u_color(this.color ?? th.scaffoldBackgroundColor),
            padding: u_ins(this.padding), elevation: this.elevation, clip: True,
            child: context.build(this.child, 0)
        }
        if (this.borderRadius != null) { node.radius = u_radius(this.borderRadius) }
        if (this.shape != null) {
            node.radius = this.shape.borderRadius == null ? null : u_radius(this.shape.borderRadius)
            if (this.shape.kind == "circle") { node.shape = "circle" }
            if (this.shape.kind == "stadium") { node.radius = u_radius(999) }
        }
        return node
    }
}

class Card extends RenderWidget {
    func init(child = null, color = null, elevation = null, margin = null, shape = null, borderRadius = null, key = null) {
        super.init(key: key)
        this.child = child
        this.color = color
        this.elevation = elevation
        this.margin = margin
        this.shape = shape
        this.borderRadius = borderRadius
    }
    func toNode(context) {
        th = Theme.of(context)
        radius = u_radius(Corners.circular(12))
        if (this.shape != null and this.shape.borderRadius != null) { radius = u_radius(this.shape.borderRadius) }
        elev = this.elevation == null ? 1 : this.elevation
        node = {
            type: "container", color: u_color(this.color ?? th.cardColor), radius: radius,
            margin: u_ins(this.margin == null ? Insets.all(4) : this.margin),
            elevation: elev, clip: True, child: context.build(this.child, 0)
        }
        if (this.shape != null and this.shape.side != null) {
            node.border = {color: u_color(this.shape.side.color), width: this.shape.side.width}
        }
        return node
    }
}

class Avatar extends View {
    func init(child = null, backgroundColor = null, foregroundColor = null, backgroundImage = null, radius = 20, key = null) {
        super.init(key: key)
        this.child = child
        this.backgroundColor = backgroundColor
        this.foregroundColor = foregroundColor
        this.backgroundImage = backgroundImage
        this.radius = radius
    }
    func build(context) {
        th = Theme.of(context)
        bg = this.backgroundColor ?? th.colorScheme.primaryContainer
        fg = this.foregroundColor ?? th.colorScheme.onPrimaryContainer
        d = this.radius * 2
        inner = this.child
        if (inner != null) {
            inner = TextDefaults(style: Font(color: fg, fontSize: this.radius * 0.8, fontWeight: 500), child: inner)
        }
        return Box(
            width: d, height: d, alignment: Alignment.center, child: inner,
            decoration: Look(color: bg, shape: "circle",
                image: this.backgroundImage == null ? null : BgImage(image: this.backgroundImage, fit: "cover")),
            clipBehavior: "antiAlias")
    }
}

class Item extends View {
    func init(title = null, subtitle = null, leading = null, trailing = null, onTap = null, onLongPress = null,
              dense = False, selected = False, enabled = True, contentPadding = null, tileColor = null,
              selectedTileColor = null, isThreeLine = False, key = null) {
        super.init(key: key)
        this.title = title
        this.subtitle = subtitle
        this.leading = leading
        this.trailing = trailing
        this.onTap = onTap
        this.onLongPress = onLongPress
        this.dense = dense
        this.selected = selected
        this.enabled = enabled
        this.contentPadding = contentPadding
        this.tileColor = tileColor
        this.selectedTileColor = selectedTileColor
    }
    func build(context) {
        th = Theme.of(context)
        cs = th.colorScheme
        tt = th.textTheme
        titleColor = this.selected ? cs.primary : (this.enabled ? null : cs.onSurface.withOpacity(0.38))
        row = []
        if (this.leading != null) {
            row.push(Pad(padding: Insets.only(right: 16), child: IconDefaults.wrap(this.leading, this.selected ? cs.primary : cs.onSurfaceVariant)))
        }
        texts = []
        if (this.title != null) {
            texts.push(TextDefaults(style: tt.bodyLarge.copyWith(color: titleColor, fontSize: this.dense ? 14 : 16), child: this.title))
        }
        if (this.subtitle != null) {
            texts.push(TextDefaults(style: tt.bodyMedium.copyWith(color: cs.onSurfaceVariant), child: this.subtitle))
        }
        row.push(Grow(child: Col(cross: "start", mainSize: "min", children: texts)))
        if (this.trailing != null) {
            row.push(Pad(padding: Insets.only(left: 16), child: IconDefaults.wrap(this.trailing, cs.onSurfaceVariant)))
        }
        minH = this.subtitle != null ? 72 : (this.dense ? 48 : 56)
        pad = this.contentPadding == null ? Insets.symmetric(horizontal: 16, vertical: 8) : this.contentPadding
        bg = this.selected ? (this.selectedTileColor ?? cs.primaryContainer.withOpacity(0.4)) : this.tileColor
        body = Box(
            color: bg, padding: pad, constraints: Limits(minHeight: minH), alignment: Alignment.centerLeft,
            child: Row(children: row))
        if (this.onTap == null and this.onLongPress == null) { return body }
        return Tap(onTap: this.enabled ? this.onTap : null, onLongPress: this.onLongPress, child: body)
    }
}

class IconDefaults {
    func wrap(w, color) {
        if (typeof(w) == "instance" and class_name(w) == "Icon" and w.color == null) {
            return Icon(w.icon, size: w.size, color: color)
        }
        return w
    }
}

