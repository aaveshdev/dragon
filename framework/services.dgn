    func heavyImpact() { Platform.invoke("haptic", {kind: "heavy"}) }
    func selectionClick() { Platform.invoke("haptic", {kind: "selection"}) }
    func vibrate(ms = 50) { Platform.invoke("vibrate", {ms: ms}) }
}
