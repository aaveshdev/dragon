import "dragon/core" as *
import "dragon/runtime" as *
import "dragon/widgets" as *

func u_ease(name, t) {
    x = u_clamp(t, 0.0, 1.0)
    if (name == null or name == "linear") { return x }
    if (name == "easeIn") { return x * x * x }
    if (name == "easeOut") { inv = 1 - x
        return 1 - inv * inv * inv }
    if (name == "easeInOut" or name == "fastOutSlowIn") {
        if (x < 0.5) { return 4 * x * x * x }
        k = -2 * x + 2
        return 1 - k * k * k / 2
    }
    if (name == "bounceOut") {
        n1 = 7.5625
        d1 = 2.75
        if (x < 1 / d1) { return n1 * x * x }
        if (x < 2 / d1) { y = x - 1.5 / d1
            return n1 * y * y + 0.75 }
        if (x < 2.5 / d1) { y = x - 2.25 / d1
            return n1 * y * y + 0.9375 }
        y = x - 2.625 / d1
        return n1 * y * y + 0.984375
    }
    if (name == "bounceIn") { return 1 - u_ease("bounceOut", 1 - x) }
    if (name == "elasticOut") {
        if (x <= 0) { return 0.0 }
        if (x >= 1) { return 1.0 }
        c4 = 2.0943951023931953
        return pow(2, -10 * x) * sin((x * 10 - 0.75) * c4) + 1
    }
    return x
}

func u_lerp(a, b, t) {
    if (typeof(a) == "instance" and class_name(a) == "Color") {
        return Color.fromARGB(
            round_int(a.a + (b.a - a.a) * t), round_int(a.r + (b.r - a.r) * t),
            round_int(a.g + (b.g - a.g) * t), round_int(a.b + (b.b - a.b) * t))
    }
    return a + (b - a) * t
}

class Tween {
    func init(begin = 0.0, end = 1.0) {
        this.begin = begin
        this.end = end
    }
    func transform(t) { return u_lerp(this.begin, this.end, t) }
    func evaluate(animation) { return u_lerp(this.begin, this.end, animation.value) }
    func animate(animation) { return TweenAnimation(this, animation) }
}
class ColorTween extends Tween {
    func init(begin = null, end = null) { super.init(begin: begin, end: end) }
}
class IntTween extends Tween {
    func init(begin = 0, end = 1) { super.init(begin: begin, end: end) }
    func transform(t) { return round_int(u_lerp(this.begin, this.end, t)) }
}

class TweenAnimation {
    func init(tween, parent) {
        this.tween = tween
        this.parent = parent
    }
    func addListener(fn) { this.parent.addListener(fn) }
    func removeListener(fn) { this.parent.removeListener(fn) }
    func get_value() { return this.tween.transform(this.parent.value) }
}

class CurvedAnimation {
    func init(parent, curve = null) {
        this.parent = parent
        this.curve = curve
    }
    func addListener(fn) { this.parent.addListener(fn) }
    func removeListener(fn) { this.parent.removeListener(fn) }
}

func animationValue(a) {
    cls = class_name(a)
    if (cls == "TweenAnimation") { return a.tween.transform(animationValue(a.parent)) }
    if (cls == "CurvedAnimation") { return u_ease(a.curve, animationValue(a.parent)) }
    return a.value
}

class Animator extends Notifier {
    func init(duration = null, vsync = null, lowerBound = 0.0, upperBound = 1.0, value = null) {
        super.init()
        this.duration = u_ms(duration == null ? Duration(milliseconds: 300) : duration)
        this.lowerBound = lowerBound
        this.upperBound = upperBound
        this.value = value == null ? lowerBound : value
        this.status = "dismissed"
        this.dir = 0
        this.looping = False
        this.reverseLoop = False
        this.last = 0
        this.target = upperBound
        this.onDone = null
        this.attached = False
    }
    func attach() {
        if (not this.attached) {
            this.attached = True
            RT.tickers.push(this)
        }
    }
    func detach() {
        this.attached = False
        me = this
        RT.tickers = RT.tickers.filter(func(t) { return not same(t, me) })
    }
    func forward(from = null) {
        if (from != null) { this.value = from }
        return this.animateTo(this.upperBound)
    }
    func reverse(from = null) {
        if (from != null) { this.value = from }
        return this.animateTo(this.lowerBound)
    }
    func animateTo(target, duration = null) {
        this.target = target
        this.looping = False
        this.last = 0
        span = this.upperBound - this.lowerBound
        frac = span == 0 ? 1.0 : abs(target - this.value) / span
        this.run_ms = u_ms(duration == null ? Duration(milliseconds: this.duration) : duration)
        this.run_ms = max(1, floor_int(this.run_ms * frac))
        this.from_v = this.value
        this.elapsed = 0
        this.dir = target >= this.value ? 1 : -1
        this.status = this.dir > 0 ? "forward" : "reverse"
        this.attach()
        RT.dirty = True
    }
    func repeat(reverse = False, period = null) {
        this.looping = True
        this.reverseLoop = reverse
        this.last = 0
        this.run_ms = u_ms(period == null ? Duration(milliseconds: this.duration) : period)
        this.from_v = this.lowerBound
        this.target = this.upperBound
        this.elapsed = 0
        this.dir = 1
        this.status = "forward"
        this.attach()
    }
    func stop() {
        this.detach()
        this.looping = False
    }
    func reset() {
        this.stop()
        this.value = this.lowerBound
        this.status = "dismissed"
        this.notifyListeners()
    }
    func isAnimating() { return this.attached }
    func isCompleted() { return this.status == "completed" }
    func isDismissed() { return this.status == "dismissed" }
    func tick(now) {
        if (this.last == 0) { this.last = now }
        this.elapsed = this.elapsed + (now - this.last)
        this.last = now
        p = u_clamp(this.elapsed / this.run_ms, 0.0, 1.0)
        this.value = this.from_v + (this.target - this.from_v) * p
        if (p >= 1.0) {
            if (this.looping) {
                if (this.reverseLoop) {
                    tmp = this.from_v
                    this.from_v = this.target
                    this.target = tmp
                } else {
                    this.value = this.lowerBound
                }
                this.elapsed = 0
            } else {
                this.value = this.target
                this.status = this.dir > 0 ? "completed" : "dismissed"
                this.detach()
            }
        }
        this.notifyListeners()
    }
    func onExit() {
        this.detach()
        this.listeners = []
    }
}

class AnimBuilder extends View {
    func init(animation, builder, child = null, key = null) {
        super.init(key: key)
        this.animation = animation
        this.builder = builder
        this.child = child
    }
    func build(context) { return this.builder(context, this.child) }
}

class TickerProviderStateMixin {
}

class HttpResponse {
    func init(m) {
        this.statusCode = m.status == null ? 0 : m.status
        this.body = m.body == null ? "" : m.body
        this.error = m.error
        this.headers = m.headers == null ? {} : m.headers
        this.ok = this.error == null and this.statusCode >= 200 and this.statusCode < 300
    }
    func json() { return json.decode(this.body) }
}

HTTP_OPTIONS = {insecure: False}

func u_http(method, url, headers, body, timeoutMs, callback, parts = null) {
    args = {method: method, url: url, headers: headers == null ? {} : headers, body: body, timeout: timeoutMs}
    if (parts != null) { args.bodyParts = parts }
    if (HTTP_OPTIONS.insecure) { args.insecure = True }
    Platform.invoke("http", args,
        func(res) {
            if (res == null) { res = {error: "no response"} }
            callback(HttpResponse(res))
        })
}

class Http {
    func allowInsecure(on) { HTTP_OPTIONS.insecure = on == True }
    func get(url, callback, headers = null, timeout = 30000) { u_http("GET", url, headers, null, timeout, callback) }
    func post(url, callback, body = null, headers = null, timeout = 30000) {
        b = body
        if (b != null and typeof(b) != "string") { b = json.encode(b) }
        u_http("POST", url, headers, b, timeout, callback)
    }
    func put(url, callback, body = null, headers = null, timeout = 30000) {
        b = body
        if (b != null and typeof(b) != "string") { b = json.encode(b) }
        u_http("PUT", url, headers, b, timeout, callback)
    }
    func delete(url, callback, headers = null, timeout = 30000) { u_http("DELETE", url, headers, null, timeout, callback) }

    func multipart(url, callback, fields, file, headers = null, timeout = 60000) {
        boundary = "----DragonFormBoundary7MA4YWxkTrZu0gW"
        parts = []
        for k in fields.keys() {
            parts.push({text: "--" + boundary + "\r\nContent-Disposition: form-data; name=\"" + k + "\"\r\n\r\n" + str(fields[k]) + "\r\n"})
        }
        parts.push({text: "--" + boundary + "\r\nContent-Disposition: form-data; name=\"" + (file.field == null ? "file" : file.field) + "\"; filename=\"" + file.name + "\"\r\nContent-Type: " + (file.type == null ? "application/octet-stream" : file.type) + "\r\n\r\n"})
        parts.push({base64: file.base64})
        parts.push({text: "\r\n--" + boundary + "--\r\n"})
        h = {}
        if (headers != null) { for k in headers.keys() { h[k] = headers[k] } }
        h["Content-Type"] = "multipart/form-data; boundary=" + boundary
        u_http("POST", url, h, null, timeout, callback, parts)
    }
}

class Prefs {
    func path() { return RT.docs_dir + "/dragon_prefs.json" }
    func load() {
        if (RT.prefs_cache != null) { return RT.prefs_cache }
        raw = file.read_all(Prefs.path())
        data = {}
        if (raw != null and raw != "") {
            try { data = json.decode(raw) } catch (e) { data = {} }
        }
        if (data == null) { data = {} }
        RT.prefs_cache = data
        return data
    }
    func save() { file.write(Prefs.path(), json.encode(Prefs.load())) }
    func get(key, fallback = null) {
        v = Prefs.load()[key]
        return v == null ? fallback : v
    }
    func set(key, value) {
        Prefs.load()[key] = value
        Prefs.save()
    }
    func remove(key) {
        Prefs.load().remove(key)
        Prefs.save()
    }
    func contains(key) { return Prefs.load()[key] != null }
    func keys() { return Prefs.load().keys() }
    func clear() {
        RT.prefs_cache = {}
        Prefs.save()
    }
}
RT.prefs_cache = null

class Clipboard {
    func setText(text) { Platform.invoke("clipboard.set", {text: text}) }
    func getText(callback) { Platform.invoke("clipboard.get", {}, func(r) { callback(r == null ? null : r.text) }) }
}
