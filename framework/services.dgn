class Time {
    func init(hour, minute) {
        this.hour = hour
        this.minute = minute
    }
    func now() {
        ms = now_ms()
        mins = floor_int(ms / 60000) % 1440
        return Time(floor_int(mins / 60), mins % 60)
    }
    func format() {
        h = str(this.hour)
        m = str(this.minute)
        if (len(h) < 2) { h = "0" + h }
        if (len(m) < 2) { m = "0" + m }
        return h + ":" + m
    }
}
class DateTime {
    func init(year, month = 1, day = 1, hour = 0, minute = 0, second = 0) {
        this.year = year
        this.month = month
        this.day = day
        this.hour = hour
        this.minute = minute
        this.second = second
    }
    func now() { return DateTime.fromMillis(now_ms()) }
    func fromMillis(ms) {
        total = floor_int(ms / 1000)
        days = floor_int(total / 86400)
        rest = total - days * 86400
        z = days + 719468
        era = floor_int(z / 146097)
        doe = z - era * 146097
        yoe = floor_int((doe - floor_int(doe / 1460) + floor_int(doe / 36524) - floor_int(doe / 146096)) / 365)
        y = yoe + era * 400
        doy = doe - (365 * yoe + floor_int(yoe / 4) - floor_int(yoe / 100))
        mp = floor_int((5 * doy + 2) / 153)
        d = doy - floor_int((153 * mp + 2) / 5) + 1
        m = mp < 10 ? mp + 3 : mp - 9
        if (m <= 2) { y = y + 1 }
        hh = floor_int(rest / 3600)
        mm = floor_int((rest - hh * 3600) / 60)
        return DateTime(y, m, d, hh, mm, rest - hh * 3600 - mm * 60)
    }
    func daysSinceEpoch() {
        y = this.month <= 2 ? this.year - 1 : this.year
        era = floor_int(y / 400)
        yoe = y - era * 400
        mi = this.month > 2 ? this.month - 3 : this.month + 9
        doy = floor_int((153 * mi + 2) / 5) + this.day - 1
        doe = yoe * 365 + floor_int(yoe / 4) - floor_int(yoe / 100) + doy
        return era * 146097 + doe - 719468
    }
    func toMillis() {
        return (this.daysSinceEpoch() * 86400 + this.hour * 3600 + this.minute * 60 + this.second) * 1000
    }
    func addDays(n) {
        r = DateTime.fromMillis((this.daysSinceEpoch() + n) * 86400000)
        r.hour = this.hour
        r.minute = this.minute
        r.second = this.second
        return r
    }
    func weekday() {
        d = this.daysSinceEpoch()
        w = (d + 3) % 7
        if (w < 0) { w = w + 7 }
        return w + 1
    }
    func isLeapYear() {
        y = this.year
        return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
    }
    func daysInMonth() {
        m = this.month
        if (m == 2) { return this.isLeapYear() ? 29 : 28 }
        if (m == 4 or m == 6 or m == 9 or m == 11) { return 30 }
        return 31
    }
    func isSameDay(other) {
        return other != null and this.year == other.year and this.month == other.month and this.day == other.day
    }

    func format(pattern = null) {
        if (pattern == null) { pattern = "yyyy-MM-dd" }
        months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
        out = []
        i = 0
        n = len(pattern)
        while (i < n) {
            c = pattern.substring(i, i + 1)
            j = i
            while (j < n and pattern.substring(j, j + 1) == c) { j = j + 1 }
            run = j - i
            if (c == "y") {
                y = str(this.year)
                if (run == 2) { out.push(y.substring(len(y) - 2, len(y))) } else { out.push(y) }
            } elif (c == "M") {
                if (run >= 4) { out.push(months[this.month - 1]) }
                elif (run == 3) { out.push(months[this.month - 1].substring(0, 3)) }
                else { out.push(run == 2 ? u_pad2(this.month) : str(this.month)) }
            } elif (c == "d") {
                out.push(run >= 2 ? u_pad2(this.day) : str(this.day))
            } elif (c == "H") {
                out.push(run >= 2 ? u_pad2(this.hour) : str(this.hour))
            } elif (c == "h") {
                h12 = this.hour % 12
                if (h12 == 0) { h12 = 12 }
                out.push(run >= 2 ? u_pad2(h12) : str(h12))
            } elif (c == "m") {
                out.push(run >= 2 ? u_pad2(this.minute) : str(this.minute))
            } elif (c == "s") {
                out.push(run >= 2 ? u_pad2(this.second) : str(this.second))
            } elif (c == "a") {
                out.push(this.hour < 12 ? "AM" : "PM")
            } else {
                k = 0
                while (k < run) {
                    out.push(c)
                    k = k + 1
                }
            }
            i = j
        }
        return out.join("")
    }
}

func u_pad2(n) {
    s = str(n)
    if (len(s) < 2) { s = "0" + s }
    return s
}

func showDatePicker(callback, initialDate = null, firstDate = null, lastDate = null) {
    init = initialDate == null ? "" : initialDate.format()
    Platform.invoke("datePicker", {initial: init}, func(r) {
        if (r == null or r.date == null) { callback(null) } else {
            p = r.date.split("-")
            callback(DateTime(parse_int(p[0]), parse_int(p[1]), parse_int(p[2])))
        }
    })
}
func showTimePicker(callback, initialTime = null) {
    init = initialTime == null ? "" : initialTime.format()
    Platform.invoke("timePicker", {initial: init}, func(r) {
        if (r == null or r.time == null) { callback(null) } else {
            p = r.time.split(":")
            callback(Time(parse_int(p[0]), parse_int(p[1])))
        }
    })
}

class AppEvents {
    func addBackHandler(fn) { RT.back_handlers.push(fn) }
    func removeBackHandler(fn) {
        RT.back_handlers = RT.back_handlers.filter(func(f) { return not same(f, fn) })
    }
    func addObserver(fn) { RT.lifecycle_listeners.push(fn) }
    func removeObserver(fn) {
        RT.lifecycle_listeners = RT.lifecycle_listeners.filter(func(f) { return not same(f, fn) })
    }
}
