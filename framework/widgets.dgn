class Transform extends RenderWidget {
    func init(child = null, angle = null, scale = null, scaleX = null, scaleY = null, dx = null, dy = null,
              alignment = null, key = null) {
        super.init(key: key)
        this.child = child
        this.angle = angle
        this.scale = scale
        this.scaleX = scaleX
        this.scaleY = scaleY
        this.dx = dx
        this.dy = dy
        this.alignment = alignment
    }
    func rotate(angle, child = null, alignment = null, key = null) {
        return Transform(angle: angle, child: child, alignment: alignment, key: key)
    }
    func scale(scale, child = null, alignment = null, key = null) {
        return Transform(scale: scale, child: child, alignment: alignment, key: key)
    }
    func translate(offset, child = null, key = null) {
        return Transform(dx: offset.dx, dy: offset.dy, child: child, key: key)
    }
    func toNode(context) {
        return {
            type: "transform", rotate: this.angle, scale: this.scale, scaleX: this.scaleX, scaleY: this.scaleY,
            dx: this.dx, dy: this.dy, alignment: u_align(this.alignment), child: context.build(this.child, 0)
        }
    }
}

class Turn extends RenderWidget {
    func init(quarterTurns, child = null, key = null) {
        super.init(key: key)
        this.quarterTurns = quarterTurns
        this.child = child
    }
    func toNode(context) {
        return {type: "transform", rotate: this.quarterTurns * 1.5707963267948966, child: context.build(this.child, 0)}
    }
}

