        super.init(key: key)
        this.builder = builder
    }
    func createState() { return StatefulBuilderState() }
}
class StatefulBuilderState extends Live {
    func build(context) {
        me = this
        return this.widget.builder(context, func(fn) { me.update(fn) })
    }
}

