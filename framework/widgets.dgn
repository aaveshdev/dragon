        super.init(key: key)
        this.color = color
        this.width = width
        this.height = height
    }
    func toNode(context) {
        return {
            type: "container", width: this.width, height: this.height == null ? 100 : this.height,
            border: {color: "#FF455A64", width: 1.0}, alignment: {x: 0, y: 0},
            child: {type: "icon", name: "close", color: "#FF455A64"}
        }
    }
}

class FlexBox extends RenderWidget {
    func init(direction, children = null, main = "start", cross = "center",
              mainSize = "max", gap = null, verticalDirection = null, key = null) {
        super.init(key: key)
        this.direction = direction
        this.children = children == null ? [] : children
        this.main = main
        this.cross = cross
        this.mainSize = mainSize
        this.gap = gap
        this.verticalDirection = verticalDirection
    }
    func toNode(context) {
        kids = context.buildAll(this.children)
        if (this.verticalDirection == "up") { kids.reverse() }
        return {
            type: "flex", dir: this.direction, main: this.main, cross: this.cross,
            mainSize: this.mainSize, spacing: this.gap, children: kids
        }
    }
}

class Row extends FlexBox {
    func init(children = null, main = "start", cross = "center",
              mainSize = "max", gap = null, textDirection = null, key = null) {
        super.init("horizontal", children: children, main: main,
                   cross: cross, mainSize: mainSize, gap: gap, key: key)
    }
}

class Col extends FlexBox {
    func init(children = null, main = "start", cross = "center",
              mainSize = "max", gap = null, verticalDirection = null, key = null) {
        super.init("vertical", children: children, main: main,
                   cross: cross, mainSize: mainSize, gap: gap,
                   verticalDirection: verticalDirection, key: key)
    }
}

class Weighted extends RenderWidget {
    func init(child = null, flex = 1, fit = "loose", key = null) {
        super.init(key: key)
        this.child = child
        this.flex = flex
        this.fit = fit
    }
    func toNode(context) {
        return {type: "flexible", flex: this.flex, fit: this.fit, child: context.build(this.child, 0)}
    }
}

class Grow extends Weighted {
    func init(child = null, flex = 1, key = null) {
        super.init(child: child, flex: flex, fit: "tight", key: key)
    }
}

class Spring extends Weighted {
    func init(flex = 1, key = null) {
        super.init(child: null, flex: flex, fit: "tight", key: key)
    }
}

class Layers extends RenderWidget {
    func init(children = null, alignment = null, fit = "loose", clipBehavior = null, key = null) {
        super.init(key: key)
        this.children = children == null ? [] : children
        this.alignment = alignment == null ? Alignment.topLeft : alignment
        this.fit = fit
        this.clipBehavior = clipBehavior
    }
    func toNode(context) {
        return {
            type: "stack", alignment: u_align(this.alignment), fit: this.fit,
            clip: this.clipBehavior == "none" ? False : null, children: context.buildAll(this.children)
        }
    }
}

class Pick extends RenderWidget {
    func init(index = 0, children = null, alignment = null, key = null) {
        super.init(key: key)
        this.index = index
        this.children = children == null ? [] : children
        this.alignment = alignment == null ? Alignment.topLeft : alignment
    }
    func toNode(context) {
        if (this.index < 0 or this.index >= len(this.children)) { return null }
        return {
            type: "stack", alignment: u_align(this.alignment),
            children: [context.build(this.children[this.index], this.index)]
        }
    }
}

class Pin extends RenderWidget {
    func init(child = null, left = null, top = null, right = null, bottom = null, width = null, height = null, key = null) {
        super.init(key: key)
        this.child = child
        this.left = left
        this.top = top
        this.right = right
        this.bottom = bottom
        this.width = width
        this.height = height
    }
    func fill(child = null, left = 0, top = 0, right = 0, bottom = 0, key = null) {
        return Pin(child: child, left: left, top: top, right: right, bottom: bottom, key: key)
    }
    func toNode(context) {
        return {
            type: "positioned", left: this.left, top: this.top, right: this.right, bottom: this.bottom,
            width: this.width, height: this.height, child: context.build(this.child, 0)
        }
    }
}

class Flow extends RenderWidget {
    func init(children = null, direction = "horizontal", gap = 0, lineGap = 0, alignment = "start",
              runAlignment = "start", cross = "start", key = null) {
        super.init(key: key)
        this.children = children == null ? [] : children
        this.direction = direction
        this.gap = gap
        this.lineGap = lineGap
        this.alignment = alignment
        this.runAlignment = runAlignment
        this.cross = cross
    }
    func toNode(context) {
        return {
            type: "wrap", dir: this.direction, spacing: this.gap, runSpacing: this.lineGap,
            alignment: this.alignment, runAlignment: this.runAlignment, cross: this.cross,
            children: context.buildAll(this.children)
        }
    }
}

class Rule extends RenderWidget {
    func init(height = null, thickness = null, indent = null, endIndent = null, color = null, key = null) {
        super.init(key: key)
        this.height = height
        this.thickness = thickness
        this.indent = indent
        this.endIndent = endIndent
        this.color = color
    }
    func toNode(context) {
        return {
            type: "divider", dir: "horizontal", space: this.height, thickness: this.thickness,
            indent: this.indent, endIndent: this.endIndent, color: u_color(this.color)
        }
    }
}

class VRule extends RenderWidget {
    func init(width = null, thickness = null, indent = null, endIndent = null, color = null, key = null) {
        super.init(key: key)
        this.width = width
        this.thickness = thickness
        this.indent = indent
        this.endIndent = endIndent
        this.color = color
    }
    func toNode(context) {
        return {
            type: "divider", dir: "vertical", space: this.width, thickness: this.thickness,
            indent: this.indent, endIndent: this.endIndent, color: u_color(this.color)
        }
    }
}

class ScrollController {
    func init() {
        ScrollController.seq = ScrollController.seq + 1
        this.id = "sc" + str(ScrollController.seq)
        this.offset = 0
        this.winStart = 0
    }
    func jumpTo(offset) {
        RT.command({cmd: "scroll", id: this.id, offset: offset, animate: False})
    }
    func animateTo(offset, duration = null, curve = null) {
        RT.command({cmd: "scroll", id: this.id, offset: offset, animate: True})
    }
    func scrollToEnd(animate = True) {
        RT.command({cmd: "scroll", id: this.id, end: True, animate: animate})
    }
    func scrollToIndex(index, animate = True) {
        RT.command({cmd: "scroll", id: this.id, index: index, animate: animate})
    }
    func onExit() { }
}
ScrollController.seq = 0

class Scroll extends RenderWidget {
    func init(child = null, scrollDirection = "vertical", padding = null, reverse = False, physics = null,
              controller = null, key = null) {
        super.init(key: key)
        this.child = child
        this.scrollDirection = scrollDirection
        this.padding = padding
        this.reverse = reverse
        this.physics = physics
        this.controller = controller
    }
    func toNode(context) {
        return {
            type: "scroll", dir: this.scrollDirection, padding: u_ins(this.padding), reverse: this.reverse,
            controller: this.controller == null ? null : this.controller.id,
            noScroll: this.physics == "never" ? True : null,
            child: context.build(this.child, 0)
        }
    }
}

class Feed extends RenderWidget {
    func init(children = null, padding = null, scrollDirection = "vertical", shrinkWrap = False, reverse = False,
              itemCount = null, itemBuilder = null, separatorBuilder = null, itemExtent = null, physics = null,
              controller = null, onEndReached = null, virtual = False, key = null) {
        super.init(key: key)
        this.children = children
        this.virtual = virtual
        this.padding = padding
        this.scrollDirection = scrollDirection
        this.shrinkWrap = shrinkWrap
        this.reverse = reverse
        this.itemCount = itemCount
        this.itemBuilder = itemBuilder
        this.separatorBuilder = separatorBuilder
        this.itemExtent = itemExtent
        this.physics = physics
        this.controller = controller
        this.onEndReached = onEndReached
    }
    func builder(itemCount, itemBuilder, padding = null, scrollDirection = "vertical", shrinkWrap = False,
                 reverse = False, itemExtent = null, physics = null, controller = null, onEndReached = null,
                 virtual = False, key = null) {
        return Feed(itemCount: itemCount, itemBuilder: itemBuilder, padding: padding,
                        scrollDirection: scrollDirection, shrinkWrap: shrinkWrap, reverse: reverse,
                        itemExtent: itemExtent, physics: physics, controller: controller, virtual: virtual,
                        onEndReached: onEndReached, key: key)
    }
    func separated(itemCount, itemBuilder, separatorBuilder, padding = null, scrollDirection = "vertical",
                   shrinkWrap = False, reverse = False, physics = null, controller = null, onEndReached = null, key = null) {
        return Feed(itemCount: itemCount, itemBuilder: itemBuilder, separatorBuilder: separatorBuilder,
                        padding: padding, scrollDirection: scrollDirection, shrinkWrap: shrinkWrap,
                        reverse: reverse, physics: physics, controller: controller,
                        onEndReached: onEndReached, key: key)
    }
    func toNode(context) {
        kids = []
        if (this.virtual and this.itemBuilder != null and this.itemExtent != null and this.controller != null
            and this.scrollDirection == "vertical" and not this.shrinkWrap) {
            total = this.itemCount == null ? 0 : this.itemCount
            ctl = this.controller
            start = ctl.winStart
            if (start > total - 1) { start = total - 1 }
            if (start < 0) { start = 0 }
            stop = start + 48
            if (stop > total) { stop = total }
            idx = start
            while (idx < stop) {
                node = context.build(this.itemBuilder(context, idx), idx)
                if (node != null) { kids.push(node) }
                idx = idx + 1
            }
            return {
                type: "list", dir: "vertical", padding: u_ins(this.padding), shrinkWrap: False,
                reverse: this.reverse, itemExtent: this.itemExtent, controller: ctl.id,
                total: total, offset: start,
                onWindow: context.on(func(first) {
                    t = first - 14
                    if (t < 0) { t = 0 }
                    ctl.winStart = t
                }, "int"),
                onEnd: context.on(this.onEndReached, "void"),
                children: kids
            }
        }
        if (this.itemBuilder != null) {
            n = this.itemCount == null ? 0 : this.itemCount
            idx = 0
            while (idx < n) {
                node = context.build(this.itemBuilder(context, idx), idx)
                if (node != null) { kids.push(node) }
                if (this.separatorBuilder != null and idx < n - 1) {
                    sep = context.build(this.separatorBuilder(context, idx), "s" + str(idx))
                    if (sep != null) { kids.push(sep) }
                }
                idx = idx + 1
            }
        } else {
            kids = context.buildAll(this.children)
        }
        return {
            type: "list", dir: this.scrollDirection, padding: u_ins(this.padding), shrinkWrap: this.shrinkWrap,
            reverse: this.reverse, itemExtent: this.itemExtent,
            controller: this.controller == null ? null : this.controller.id,
            noScroll: this.physics == "never" ? True : null,
            onEnd: context.on(this.onEndReached, "void"),
            children: kids
        }
    }
}

