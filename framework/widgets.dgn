    func init(builder, key = null) {
        super.init(key: key)
        this.builder = builder
    }
    func build(context) {
        o = RT.media.width > RT.media.height ? "landscape" : "portrait"
        return this.builder(context, o)
    }
}

class Notifier {
    func init() {
        this.listeners = []
    }
    func addListener(fn) { this.listeners.push(fn) }
    func removeListener(fn) {
        keep = []
        for f in this.listeners {
            if (not same(f, fn)) { keep.push(f) }
        }
        this.listeners = keep
    }
    func notifyListeners() {
        for f in this.listeners { f() }
        RT.dirty = True
    }
    func onExit() { this.listeners = [] }
}

class Signal extends Notifier {
    func init(value = null) {
        super.init()
        this.value = value
    }
    func setValue(v) {
        this.value = v
        this.notifyListeners()
    }
}

class NotifierBuilder extends View {
    func init(listenable, builder, child = null, key = null) {
        super.init(key: key)
        this.listenable = listenable
        this.builder = builder
        this.child = child
    }
    func build(context) { return this.builder(context, this.child) }
}

class SignalBuilder extends View {
    func init(valueListenable, builder, child = null, key = null) {
        super.init(key: key)
        this.valueListenable = valueListenable
        this.builder = builder
        this.child = child
    }
    func build(context) { return this.builder(context, this.valueListenable.value, this.child) }
}

class Touch extends RenderWidget {
    func init(child = null, onTap = null, onDoubleTap = null, onLongPress = null, onTapDown = null,
              onPanStart = null, onPanUpdate = null, onPanEnd = null,
              onHorizontalDragUpdate = null, onVerticalDragUpdate = null,
              onHorizontalDragEnd = null, onVerticalDragEnd = null, behavior = null, key = null) {
        super.init(key: key)
        this.child = child
        this.onTap = onTap
        this.onDoubleTap = onDoubleTap
        this.onLongPress = onLongPress
        this.onTapDown = onTapDown
        this.onPanStart = onPanStart
        this.onPanUpdate = onPanUpdate
        this.onPanEnd = onPanEnd
        this.onHorizontalDragUpdate = onHorizontalDragUpdate
        this.onVerticalDragUpdate = onVerticalDragUpdate
        this.onHorizontalDragEnd = onHorizontalDragEnd
        this.onVerticalDragEnd = onVerticalDragEnd
        this.ripple = False
        this.borderRadius = null
    }
    func toNode(context) {
        return {
            type: "gesture",
            ripple: this.ripple ? True : null,
            radius: u_radius(this.borderRadius),
            onTap: context.on(this.onTap, "void"),
            onDoubleTap: context.on(this.onDoubleTap, "void"),
            onLongPress: context.on(this.onLongPress, "void"),
            onTapDown: context.on(this.onTapDown, "pos"),
            onPanStart: context.on(this.onPanStart, "pos"),
            onPanUpdate: context.on(this.onPanUpdate, "pos"),
            onPanEnd: context.on(this.onPanEnd, "void"),
            onHDrag: context.on(this.onHorizontalDragUpdate, "num"),
            onVDrag: context.on(this.onVerticalDragUpdate, "num"),
            onHDragEnd: context.on(this.onHorizontalDragEnd, "void"),
            onVDragEnd: context.on(this.onVerticalDragEnd, "void"),
            child: context.build(this.child, 0)
        }
    }
}

class Tap extends Touch {
    func init(child = null, onTap = null, onDoubleTap = null, onLongPress = null, borderRadius = null, key = null) {
        super.init(child: child, onTap: onTap, onDoubleTap: onDoubleTap, onLongPress: onLongPress, key: key)
        this.ripple = True
        this.borderRadius = borderRadius
    }
}
class TapArea extends Tap {
