    }
    func toNode(context) { return context.build(this.child, 0) }
}

class Fade extends RenderWidget {
    func init(opacity, child = null, key = null) {
        super.init(key: key)
        this.opacity = opacity
        this.child = child
    }
    func toNode(context) {
        return {type: "opacity", opacity: this.opacity, child: context.build(this.child, 0)}
    }
}

class Show extends RenderWidget {
    func init(visible = True, child = null, replacement = null, maintainState = False, maintainSize = False, key = null) {
        super.init(key: key)
        this.visible = visible
        this.child = child
        this.replacement = replacement
        this.maintainSize = maintainSize
    }
    func toNode(context) {
        if (this.visible) { return context.build(this.child, 0) }
        if (this.maintainSize) {
            return {type: "visibility", visible: False, child: context.build(this.child, 0)}
        }
        return context.build(this.replacement, 1)
    }
}

class Hidden extends RenderWidget {
    func init(offstage = True, child = null, key = null) {
        super.init(key: key)
        this.offstage = offstage
        this.child = child
    }
    func toNode(context) {
        if (this.offstage) { return null }
        return context.build(this.child, 0)
    }
}

