class Swipe extends RenderWidget {
    func init(key, child, onDismissed = null, background = null, direction = "horizontal", confirmDismiss = null) {
        super.init(key: key)
        this.child = child
        this.onDismissed = onDismissed
        this.background = background
        this.direction = direction
    }
    func toNode(context) {
        cb = this.onDismissed
        handler = func(dir) { if (cb != null) { cb(dir) } }
        return {
            type: "dismissible", direction: this.direction, onDismissed: context.on(handler, "str"),
            background: context.build(this.background, "bg"), child: context.build(this.child, 0)
        }
    }
}

class AnimBox extends Box {
    func init(child = null, duration = null, curve = null, width = null, height = null, padding = null,
              margin = null, color = null, decoration = null, alignment = null, constraints = null, key = null) {
        super.init(child: child, width: width, height: height, padding: padding, margin: margin, color: color,
                   decoration: decoration, alignment: alignment, constraints: constraints, key: key)
        this.duration = duration
        this.curve = curve
    }
    func toNode(context) {
        node = this.baseNode(context)
        node.duration = u_ms(this.duration)
        node.curve = this.curve
        return node
    }
}

