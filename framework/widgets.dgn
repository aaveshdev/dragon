class CrossFadeState {
    showFirst = "showFirst"
    showSecond = "showSecond"
}

class AnimCross extends RenderWidget {
    func init(firstChild, secondChild, crossFadeState, duration, key = null) {
        super.init(key: key)
        this.firstChild = firstChild
        this.secondChild = secondChild
        this.crossFadeState = crossFadeState
        this.duration = duration
    }
    func toNode(context) {
        first = this.crossFadeState == "showFirst"
        picked = first ? this.firstChild : this.secondChild
        inner = context.build(picked, first ? "a" : "b")
        if (inner != null) { inner.wkey = first ? "a" : "b" }
        return {type: "animatedSwitcher", duration: u_ms(this.duration), child: inner}
    }
}

class Paint {
    func init(color = null, style = "fill", strokeWidth = 1.0, strokeCap = "butt", isAntiAlias = True) {
        this.color = color
        this.style = style
        this.strokeWidth = strokeWidth
        this.strokeCap = strokeCap
    }
    func toJson() {
        return {color: u_color(this.color == null ? Colors.black : this.color), style: this.style,
                width: this.strokeWidth, cap: this.strokeCap}
    }
}
PaintingStyle = {fill: "fill", stroke: "stroke"}
StrokeCap = {butt: "butt", round: "round", square: "square"}

class Path {
    func init() { this.cmds = [] }
    func moveTo(x, y) { this.cmds.push(["M", x, y]) }
    func lineTo(x, y) { this.cmds.push(["L", x, y]) }
    func quadraticBezierTo(x1, y1, x2, y2) { this.cmds.push(["Q", x1, y1, x2, y2]) }
    func cubicTo(x1, y1, x2, y2, x3, y3) { this.cmds.push(["C", x1, y1, x2, y2, x3, y3]) }
    func close() { this.cmds.push(["Z"]) }
}

class Canvas {
    func init() { this.ops = [] }
    func drawLine(p1, p2, paint) {
        this.ops.push({op: "line", x1: p1.dx, y1: p1.dy, x2: p2.dx, y2: p2.dy, paint: paint.toJson()})
    }
    func drawRect(x, y, w, h, paint) {
        this.ops.push({op: "rect", x: x, y: y, w: w, h: h, paint: paint.toJson()})
    }
    func drawRRect(x, y, w, h, radius, paint) {
        this.ops.push({op: "rrect", x: x, y: y, w: w, h: h, r: radius, paint: paint.toJson()})
    }
    func drawCircle(center, radius, paint) {
        this.ops.push({op: "circle", x: center.dx, y: center.dy, r: radius, paint: paint.toJson()})
    }
    func drawOval(x, y, w, h, paint) {
        this.ops.push({op: "oval", x: x, y: y, w: w, h: h, paint: paint.toJson()})
    }
    func drawArc(x, y, w, h, startAngle, sweepAngle, useCenter, paint) {
        this.ops.push({op: "arc", x: x, y: y, w: w, h: h, start: startAngle, sweep: sweepAngle,
                       center: useCenter, paint: paint.toJson()})
    }
    func drawPath(path, paint) {
        this.ops.push({op: "path", cmds: path.cmds, paint: paint.toJson()})
    }
    func drawText(text, x, y, style = null, align = null) {
        this.ops.push({op: "text", text: text, x: x, y: y, style: u_style(style), align: align})
    }
}

class Drawing extends RenderWidget {
    func init(painter = null, size = null, child = null, key = null) {
        super.init(key: key)
        this.painter = painter
        this.size = size == null ? Size(width: 100, height: 100) : size
        this.child = child
    }
    func toNode(context) {
        cv = Canvas()
        if (this.painter != null) {
            if (typeof(this.painter) == "function") {
                this.painter(cv, this.size)
            } else {
                this.painter.paint(cv, this.size)
            }
        }
        return {
            type: "canvas", width: this.size.width, height: this.size.height, ops: cv.ops,
            child: context.build(this.child, 0)
        }
    }
}

WRAP.add("pad", func(w, a, b, c) { return Pad(a, w) })
WRAP.add("inset", func(w, a, b, c) { return Box(child: w, margin: a) })
WRAP.add("bg", func(w, a, b, c) { return Box(child: w, color: a) })
WRAP.add("sized", func(w, a, b, c) { return Space(width: a, height: b, child: w) })
WRAP.add("round", func(w, a, b, c) { return Round(a, child: w) })
WRAP.add("outline", func(w, a, b, c) {
    return Box(child: w, decoration: Look(border: Border.all(color: a == null ? Colors.grey : a, width: b), borderRadius: c))
})
WRAP.add("centered", func(w, a, b, c) { return Center(child: w) })
WRAP.add("aligned", func(w, a, b, c) { return Place(alignment: a, child: w) })
WRAP.add("grow", func(w, a, b, c) { return Grow(w, flex: a) })
WRAP.add("tap", func(w, a, b, c) { return Tap(child: w, onTap: a) })
WRAP.add("longPress", func(w, a, b, c) { return Tap(child: w, onLongPress: a) })
WRAP.add("faded", func(w, a, b, c) { return Fade(a, child: w) })
WRAP.add("when", func(w, a, b, c) { return a ? w : Space() })
WRAP.add("scrolls", func(w, a, b, c) { return Scroll(child: w) })
WRAP.add("safe", func(w, a, b, c) { return Safe(child: w) })
WRAP.add("tip", func(w, a, b, c) { return Hint(a, child: w) })
