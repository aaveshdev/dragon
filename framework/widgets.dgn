class Place extends RenderWidget {
    func init(alignment = null, child = null, widthFactor = null, heightFactor = null, key = null) {
        super.init(key: key)
        this.alignment = alignment == null ? Alignment.center : alignment
        this.child = child
        this.widthFactor = widthFactor
        this.heightFactor = heightFactor
    }
    func toNode(context) {
        return {
            type: "align", alignment: u_align(this.alignment),
            widthFactor: this.widthFactor, heightFactor: this.heightFactor,
            child: context.build(this.child, 0)
        }
    }
}

class Center extends Place {
    func init(child = null, widthFactor = null, heightFactor = null, key = null) {
        super.init(alignment: Alignment.center, child: child, widthFactor: widthFactor, heightFactor: heightFactor, key: key)
    }
}

class Space extends RenderWidget {
    func init(width = null, height = null, child = null, key = null) {
        super.init(key: key)
        this.width = width
        this.height = height
        this.child = child
    }
    func shrink() { return Space(width: 0, height: 0) }
    func expand(child = null) { return Space(width: INFINITY, height: INFINITY, child: child) }
    func square(dimension = null, child = null) { return Space(width: dimension, height: dimension, child: child) }
    func fromSize(size, child = null) { return Space(width: size.width, height: size.height, child: child) }
    func toNode(context) {
        return {type: "sizedBox", width: u_dim(this.width), height: u_dim(this.height), child: context.build(this.child, 0)}
    }
}

class Limit extends RenderWidget {
    func init(constraints, child = null, key = null) {
        super.init(key: key)
        this.constraints = constraints
        this.child = child
    }
    func toNode(context) {
        cn = this.constraints
        node = {type: "constrained", child: context.build(this.child, 0)}
        if (cn.minWidth > 0) { node.minWidth = cn.minWidth }
        if (cn.maxWidth < INFINITY) { node.maxWidth = cn.maxWidth }
        if (cn.minHeight > 0) { node.minHeight = cn.minHeight }
        if (cn.maxHeight < INFINITY) { node.maxHeight = cn.maxHeight }
        return node
    }
}

class LimitMax extends Limit {
    func init(maxWidth = INFINITY, maxHeight = INFINITY, child = null, key = null) {
        super.init(Limits(maxWidth: maxWidth, maxHeight: maxHeight), child: child, key: key)
    }
}

