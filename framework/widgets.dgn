import "dragon/core" as *
import "dragon/runtime" as *

func u_dim(v) {
    if (v == null) { return null }
    return v
}

class TextDefaults extends Provider {
    func init(style, child = null, textAlign = null, maxLines = null, overflow = null, key = null) {
        super.init(child: child, key: key)
        this.style = style
        this.textAlign = textAlign
        this.maxLines = maxLines
        this.overflow = overflow
    }
    func of(context) {
        d = context.findInherited("TextDefaults")
        if (d == null) { return Font() }
        return d.style
    }
}

class Text extends RenderWidget {
    func init(data, style = null, textAlign = null, maxLines = null, overflow = null, softWrap = null,
              textScaleFactor = null, semanticsLabel = null, key = null,
              color = null, size = null, weight = null, bold = False, italic = False, align = null) {
        super.init(key: key)
        this.data = data
        if (color != null or size != null or weight != null or bold or italic) {
            flat = Font(color: color, fontSize: size, fontWeight: bold ? 700 : weight, fontStyle: italic ? "italic" : null)
            style = style == null ? flat : style.merge(flat)
        }
        if (textAlign == null) { textAlign = align }
        this.style = style
        this.textAlign = textAlign
        this.maxLines = maxLines
        this.overflow = overflow
        this.softWrap = softWrap
        this.textScaleFactor = textScaleFactor
    }
    func rich(textSpan, style = null, textAlign = null, maxLines = null, overflow = null, key = null) {
        return RichText(text: textSpan, style: style, textAlign: textAlign, maxLines: maxLines, overflow: overflow, key: key)
    }
    func toNode(context) {
        dts = context.findInherited("TextDefaults")
        st = this.style
        al = this.textAlign
        ml = this.maxLines
        ov = this.overflow
        if (dts != null) {
            st = dts.style.merge(this.style)
            if (al == null) { al = dts.textAlign }
            if (ml == null) { ml = dts.maxLines }
            if (ov == null) { ov = dts.overflow }
        }
        return {
            type: "text",
            text: this.data == null ? "" : str(this.data),
            style: u_style(st),
            align: al,
            maxLines: ml,
            overflow: ov,
            softWrap: this.softWrap,
            scale: this.textScaleFactor
        }
    }
}

class RichText extends RenderWidget {
    func init(text, style = null, textAlign = null, maxLines = null, overflow = null, key = null) {
        super.init(key: key)
        this.text = text
        this.style = style
        this.textAlign = textAlign
        this.maxLines = maxLines
        this.overflow = overflow
    }
    func flatten(span, inherited, context, out) {
        st = inherited
        if (span.style != null) { st = inherited == null ? span.style : inherited.merge(span.style) }
        if (span.text != null) {
            piece = {text: span.text, style: u_style(st)}
            if (span.onTap != null) { piece.onTap = context.on(span.onTap, "void") }
            out.push(piece)
        }
        if (span.children != null) {
            for sub in span.children { this.flatten(sub, st, context, out) }
        }
    }
    func toNode(context) {
        dts = context.findInherited("TextDefaults")
        base = dts == null ? null : dts.style
        spans = []
        this.flatten(this.text, base, context, spans)
        return {
            type: "richText",
            spans: spans,
            style: u_style(this.style),
            align: this.textAlign,
            maxLines: this.maxLines,
            overflow: this.overflow
        }
    }
}

class SelectableText extends Text {
    func init(data, style = null, textAlign = null, maxLines = null, key = null) {
        super.init(data, style: style, textAlign: textAlign, maxLines: maxLines, key: key)
    }
}

class Icon extends RenderWidget {
    func init(icon, size = null, color = null, semanticLabel = null, key = null) {
        super.init(key: key)
        this.icon = icon
        this.size = size
        this.color = color
    }
    func toNode(context) {
        return {type: "icon", name: this.icon, size: this.size, color: u_color(this.color)}
    }
}

class Picture extends RenderWidget {
    func init(image = null, width = null, height = null, fit = null, color = null, alignment = null,
              errorBuilder = null, opacity = null, key = null) {
        super.init(key: key)
        this.image = image
        this.width = width
        this.height = height
        this.fit = fit
        this.color = color
        this.alignment = alignment
        this.errorBuilder = errorBuilder
    }
    func network(src, width = null, height = null, fit = null, color = null, alignment = null, errorBuilder = null, key = null) {
        return Picture(image: UrlImage(src), width: width, height: height, fit: fit, color: color,
                     alignment: alignment, errorBuilder: errorBuilder, key: key)
    }
    func asset(name, width = null, height = null, fit = null, color = null, alignment = null, errorBuilder = null, key = null) {
        return Picture(image: AssetImage(name), width: width, height: height, fit: fit, color: color,
                     alignment: alignment, errorBuilder: errorBuilder, key: key)
    }
    func file(path, width = null, height = null, fit = null, color = null, alignment = null, errorBuilder = null, key = null) {
        return Picture(image: FileImage(path), width: width, height: height, fit: fit, color: color,
                     alignment: alignment, errorBuilder: errorBuilder, key: key)
    }
    func toNode(context) {
        return {
            type: "image",
            src: this.image.src,
            kind: this.image.kind,
            width: u_dim(this.width),
            height: u_dim(this.height),
            fit: this.fit,
            color: u_color(this.color),
            alignment: u_align(this.alignment),
            error: this.errorBuilder == null ? null : context.build(this.errorBuilder(context, "error"), "err")
        }
    }
}

class NativeView extends RenderWidget {
    func init(kind, id = "", params = null, key = null) {
        super.init(key: key)
        this.kind = kind
        this.id = id
        this.params = params == null ? {} : params
    }
    func toNode(context) { return {type: "nativeview", kind: this.kind, id: this.id, params: this.params} }
}

class Box extends RenderWidget {
    func init(child = null, width = null, height = null, padding = null, margin = null, color = null,
              decoration = null, alignment = null, constraints = null, transform = null, clipBehavior = null,
              key = null) {
        super.init(key: key)
        this.child = child
        this.width = width
        this.height = height
        this.padding = padding
        this.margin = margin
        this.color = color
        this.decoration = decoration
        this.alignment = alignment
        this.constraints = constraints
        this.clipBehavior = clipBehavior
    }

    func baseNode(context) {
        dec = this.decoration
        node = {
            type: "container",
            width: u_dim(this.width),
            height: u_dim(this.height),
            padding: u_ins(this.padding),
            margin: u_ins(this.margin),
            alignment: u_align(this.alignment),
            color: u_color(this.color)
        }
        if (this.constraints != null) {
            cn = this.constraints
            if (cn.minWidth > 0) { node.minWidth = cn.minWidth }
            if (cn.maxWidth < INFINITY) { node.maxWidth = cn.maxWidth }
            if (cn.minHeight > 0) { node.minHeight = cn.minHeight }
            if (cn.maxHeight < INFINITY) { node.maxHeight = cn.maxHeight }
            if (cn.minWidth >= INFINITY) { node.width = INFINITY }
            if (cn.minHeight >= INFINITY) { node.height = INFINITY }
        }
        if (dec != null) {
            if (dec.color != null) { node.color = u_color(dec.color) }
            node.gradient = u_gradient(dec.gradient)
            node.radius = u_radius(dec.borderRadius)
            if (dec.border != null) { node.border = dec.border.toJson() }
            node.shadows = u_shadows(dec.boxShadow)
            if (dec.shape == "circle") { node.shape = "circle" }
            if (dec.image != null) {
                node.bgImage = {src: dec.image.image.src, kind: dec.image.image.kind, fit: dec.image.fit}
            }
        }
        if (this.clipBehavior != null and this.clipBehavior != "none") { node.clip = True }
        node.child = context.build(this.child, 0)
        return node
    }

    func toNode(context) { return this.baseNode(context) }
}

class Frame extends RenderWidget {
    func init(decoration, child = null, key = null) {
        super.init(key: key)
        this.decoration = decoration
        this.child = child
    }
    func toNode(context) {
        return Box(child: this.child, decoration: this.decoration).baseNode(context)
    }
}

