class Grid extends RenderWidget {
    func init(gridDelegate, children = null, padding = null, scrollDirection = "vertical", shrinkWrap = False,
              itemCount = null, itemBuilder = null, physics = null, controller = null, onEndReached = null, key = null) {
        super.init(key: key)
        this.gridDelegate = gridDelegate
        this.children = children
        this.padding = padding
        this.scrollDirection = scrollDirection
        this.shrinkWrap = shrinkWrap
        this.itemCount = itemCount
        this.itemBuilder = itemBuilder
        this.physics = physics
        this.controller = controller
        this.onEndReached = onEndReached
    }
    func count(columns, children = null, mainAxisSpacing = 0, crossAxisSpacing = 0, ratio = 1.0,
               padding = null, shrinkWrap = False, scrollDirection = "vertical", physics = null, controller = null, key = null) {
        return Grid(
            GridColumns(columns: columns, mainAxisSpacing: mainAxisSpacing,
                crossAxisSpacing: crossAxisSpacing, ratio: ratio),
            children: children, padding: padding, shrinkWrap: shrinkWrap, scrollDirection: scrollDirection,
            physics: physics, controller: controller, key: key)
    }
    func extent(maxCrossAxisExtent, children = null, mainAxisSpacing = 0, crossAxisSpacing = 0, ratio = 1.0,
                padding = null, shrinkWrap = False, scrollDirection = "vertical", physics = null, controller = null, key = null) {
        return Grid(
            GridMaxWidth(maxCrossAxisExtent: maxCrossAxisExtent, mainAxisSpacing: mainAxisSpacing,
                crossAxisSpacing: crossAxisSpacing, ratio: ratio),
            children: children, padding: padding, shrinkWrap: shrinkWrap, scrollDirection: scrollDirection,
            physics: physics, controller: controller, key: key)
    }
    func builder(gridDelegate, itemCount, itemBuilder, padding = null, shrinkWrap = False, scrollDirection = "vertical",
                 physics = null, controller = null, onEndReached = null, key = null) {
        return Grid(gridDelegate, itemCount: itemCount, itemBuilder: itemBuilder, padding: padding,
                        shrinkWrap: shrinkWrap, scrollDirection: scrollDirection, physics: physics,
                        controller: controller, onEndReached: onEndReached, key: key)
    }
    func toNode(context) {
        kids = []
        if (this.itemBuilder != null) {
            n = this.itemCount == null ? 0 : this.itemCount
            idx = 0
            while (idx < n) {
                node = context.build(this.itemBuilder(context, idx), idx)
                if (node != null) { kids.push(node) }
                idx = idx + 1
            }
        } else {
            kids = context.buildAll(this.children)
        }
        gd = this.gridDelegate
        return {
            type: "grid", dir: this.scrollDirection, columns: gd.columns, maxExtent: gd.maxCrossAxisExtent,
            mainSpacing: gd.mainAxisSpacing, crossSpacing: gd.crossAxisSpacing, ratio: gd.ratio,
            padding: u_ins(this.padding), shrinkWrap: this.shrinkWrap,
            controller: this.controller == null ? null : this.controller.id,
            noScroll: this.physics == "never" ? True : null,
            onEnd: context.on(this.onEndReached, "void"),
            children: kids
        }
    }
}

class PageController {
    func init(initialPage = 0) {
        this.page = initialPage
        this.initialPage = initialPage
    }
    func jumpToPage(index) {
        this.page = index
        RT.dirty = True
    }
    func animateToPage(index, duration = null, curve = null) {
        this.page = index
        RT.dirty = True
    }
    func nextPage(duration = null, curve = null) { this.animateToPage(this.page + 1) }
    func previousPage(duration = null, curve = null) { this.animateToPage(this.page - 1) }
    func onExit() { }
}

class Pager extends RenderWidget {
    func init(children = null, controller = null, onPageChanged = null, scrollDirection = "horizontal",
              physics = null, itemCount = null, itemBuilder = null, key = null) {
        super.init(key: key)
        this.children = children
        this.controller = controller
        this.onPageChanged = onPageChanged
        this.scrollDirection = scrollDirection
        this.physics = physics
        this.itemCount = itemCount
        this.itemBuilder = itemBuilder
    }
    func builder(itemCount, itemBuilder, controller = null, onPageChanged = null, scrollDirection = "horizontal", key = null) {
        return Pager(itemCount: itemCount, itemBuilder: itemBuilder, controller: controller,
                        onPageChanged: onPageChanged, scrollDirection: scrollDirection, key: key)
    }
    func toNode(context) {
        kids = []
        if (this.itemBuilder != null) {
            idx = 0
            while (idx < this.itemCount) {
                node = context.build(this.itemBuilder(context, idx), idx)
                if (node != null) { kids.push(node) }
                idx = idx + 1
            }
        } else {
            kids = context.buildAll(this.children)
        }
        ctl = this.controller
        cb = this.onPageChanged
        handler = func(i) {
            if (ctl != null) { ctl.page = i }
            if (cb != null) { cb(i) }
        }
        return {
            type: "pageView", dir: this.scrollDirection, index: ctl == null ? 0 : ctl.page,
            noScroll: this.physics == "never" ? True : null,
            onChanged: context.on(handler, "int"), children: kids
        }
    }
}

